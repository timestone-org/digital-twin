{
  "daily_energy": {
    "format_version": "1.0",
    "nodes": [
      {
        "id": "s",
        "operator": "ledger_source",
        "alias": "历史生产：选择台账",
        "config": {
          "table_code": "",
          "since": "-180d",
          "row_source": "collect"
        },
        "position": {
          "left": 80,
          "top": 100
        }
      },
      {
        "id": "c",
        "operator": "select_columns",
        "alias": "选择计划产量、工单等列",
        "config": {
          "columns": ["计划产量", "工单数", "能耗"]
        },
        "position": {
          "left": 300,
          "top": 100
        }
      },
      {
        "id": "a",
        "operator": "resample",
        "alias": "汇总完整日：按列设置口径",
        "config": {
          "bucket": "1d",
          "agg": "sum",
          "missing_policy": "propagate",
          "should_keep_complete_buckets": true
        },
        "position": {
          "left": 520,
          "top": 100
        }
      },
      {
        "id": "d",
        "operator": "drop_missing",
        "alias": "剔除缺失实际能耗的日期",
        "config": {
          "axis": "row",
          "subset": ["能耗"]
        },
        "position": {
          "left": 740,
          "top": 100
        }
      },
      {
        "id": "f",
        "operator": "fill_missing",
        "alias": "仅填充特征缺失",
        "config": {},
        "position": {
          "left": 960,
          "top": 100
        }
      },
      {
        "id": "z",
        "operator": "standardize",
        "alias": "仅按训练段标准化特征",
        "config": {},
        "position": {
          "left": 1180,
          "top": 100
        }
      },
      {
        "id": "p",
        "operator": "split_dataset",
        "alias": "按时间留出最近 20% 验证",
        "config": {
          "target_column": "能耗",
          "method": "time_order",
          "test_ratio": 0.2,
          "min_test_rows": 7
        },
        "position": {
          "left": 1400,
          "top": 100
        }
      },
      {
        "id": "m",
        "operator": "linear_regression",
        "alias": "每日能耗模型（含基础能耗）",
        "config": {
          "use_intercept": true,
          "regularization": "none"
        },
        "position": {
          "left": 1620,
          "top": 100
        }
      },
      {
        "id": "v",
        "operator": "regression_metrics",
        "alias": "查看误差后发布模型",
        "config": {},
        "position": {
          "left": 1840,
          "top": 100
        }
      }
    ],
    "edges": [
      {
