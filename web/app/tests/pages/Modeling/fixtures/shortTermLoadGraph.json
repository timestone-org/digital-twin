{
  "format_version": "1.0",
  "nodes": [
    {
      "id": "s",
      "operator": "ledger_source",
      "alias": "选择历史负荷与生产计划台账",
      "config": {
        "table_code": "",
        "since": "-120d",
        "row_source": "collect"
      },
      "position": {
        "left": 80,
        "top": 100
      }
    },
    {
      "id": "c",
      "operator": "select_columns",
      "alias": "选择预测时已知的计划与气象字段",
      "config": {
        "columns": ["计划产量", "工单数", "预报温度", "负荷"]
      },
      "position": {
        "left": 300,
        "top": 100
      }
    },
    {
      "id": "a",
      "operator": "resample",
      "alias": "完整半小时：负荷取平均功率",
      "config": {
        "bucket": "30m",
        "agg": "avg",
        "column_aggregations": {
          "计划产量": "sum",
          "工单数": "sum"
        },
        "missing_policy": "propagate",
        "should_keep_complete_buckets": true
      },
      "position": {
        "left": 520,
        "top": 100
      }
    },
    {
      "id": "h",
      "operator": "select_columns",
      "alias": "仅取历史负荷",
      "config": {
        "columns": ["负荷"]
      },
      "position": {
        "left": 740,
        "top": 320
      }
    },
    {
      "id": "h6",
      "operator": "time_shift",
      "alias": "6 小时前负荷 → 目标时刻",
      "config": {
        "offset_minutes": 360
      },
      "position": {
        "left": 960,
        "top": 320
      }
    },
    {
      "id": "hd",
      "operator": "time_shift",
