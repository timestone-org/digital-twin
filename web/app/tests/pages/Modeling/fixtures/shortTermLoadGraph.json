        "offset_minutes": 10080
      },
      "position": {
        "left": 1400,
        "top": 760
      }
    },
    {
      "id": "j6",
      "operator": "ledger_join",
      "alias": "精确关联 6 小时前负荷",
      "config": {
        "how": "left",
        "tolerance_ms": 0,
        "right_prefix": "六小时前_"
      },
      "position": {
        "left": 1180,
        "top": 100
      }
    },
    {
      "id": "jd",
      "operator": "ledger_join",
      "alias": "精确关联昨日同时刻",
      "config": {
        "how": "left",
        "tolerance_ms": 0,
        "right_prefix": "昨日_"
      },
      "position": {
        "left": 1400,
        "top": 100
      }
    },
    {
      "id": "jw",
      "operator": "ledger_join",
      "alias": "精确关联上周同时刻",
      "config": {
        "how": "left",
        "tolerance_ms": 0,
        "right_prefix": "上周_"
      },
      "position": {
        "left": 1620,
        "top": 100
      }
    },
    {
      "id": "d",
      "operator": "drop_missing",
      "alias": "剔除缺失目标或历史输入的时段",
      "config": {
        "axis": "row",
        "how": "any",
        "subset": [
          "负荷",
          "六小时前_负荷",
          "昨日_负荷",
          "上周_负荷",
          "计划产量",
          "工单数",
          "预报温度"
        ]
      },
      "position": {
        "left": 1840,
        "top": 100
      }
    },
    {
      "id": "t",
      "operator": "cyclic_time",
      "alias": "半小时时刻的日内 / 周内周期",
      "config": {
        "cycles": ["day", "week"],
        "timezone_offset_minutes": 480
      },
      "position": {
        "left": 2060,
        "top": 100
      }
    },
    {
      "id": "z",
      "operator": "standardize",
      "alias": "只用训练段拟合标准化",
      "config": {},
      "position": {
        "left": 2280,
        "top": 100
      }
    },
    {
      "id": "p",
      "operator": "split_dataset",
      "alias": "按时间留出最近 20%（至少 7 天）",
      "config": {
        "target_column": "负荷",
        "method": "time_order",
        "test_ratio": 0.2,
        "min_test_rows": 336
      },
      "position": {
        "left": 2500,
        "top": 100
      }
    },
    {
      "id": "m",
      "operator": "linear_regression",
      "alias": "未来 6 小时半小时负荷模型",
      "config": {
        "use_intercept": true,
        "regularization": "ridge",
        "ridge_alpha": 1
      },
      "position": {
        "left": 2720,
        "top": 100
      }
    },
    {
      "id": "v",
      "operator": "regression_metrics",
      "alias": "检查 kW 误差后发布",
      "config": {},
      "position": {
        "left": 2940,
        "top": 100
      }
    }
