# 单机编排的环境变量模板。密钥类留空，**必填**。
# ⚠ 本文件可以提交；填好取值的 .env 不许进版本库。

# —— 边缘 ——
EDGE_HTTP_PORT=8080

# —— PostgreSQL（必填）——
POSTGRES_HOST=10.12.0.2
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# —— Redis（必填 host）——
REDIS_HOST=10.12.0.2
REDIS_PORT=6379
REDIS_PASSWORD=

# —— 外部只读数据源：现场能源管理系统的 SQL Server（必填）——
# platform-server 只读它，不落地、不缓存、不同步，见 docs/adr/0006。
ACSOURCE_HOST=
ACSOURCE_PORT=1433
ACSOURCE_USER=
ACSOURCE_PASSWORD=
ACSOURCE_DB=
# 外库时间列的时区口径。库里存的是 naive 当地时，对外一律 UTC
ACSOURCE_TIMEZONE=Asia/Shanghai
# 驱动的客户端字符集。⚠ 现场 EMS 的 varchar 列是 CP936，用默认 UTF-8 会出乱码
ACSOURCE_CHARSET=CP936

# —— 密钥（必填，各 32 字节以上：openssl rand -hex 32）——
# 令牌签名密钥。换它会让所有已签发的令牌立刻失效（全体登出），
# 轮换时把旧值放进 AUTH_JWT_PREVIOUS_SECRET，观察归零后再清空。
AUTH_JWT_SECRET=
AUTH_JWT_PREVIOUS_SECRET=
# 边缘注入上游的身份头签名密钥。各上游服务必须取同一个值。
AUTH_EDGE_SIGNING_SECRET=
# /internal/ 的服务级密钥。未配置一律拒绝，不是放行。
AUTH_EDGE_SERVICE_KEY=

# —— 开机事件抽取的 worker（docs/AC_STARTUP_DESIGN.md §5）——
# 分片队列的流名与消费组。多副本 worker 共用一个消费组，各取各的分片
ACSTARTUP_STREAM=platform:ac-startup:shards
ACSTARTUP_GROUP=ac-startup-workers

# —— 功能开关 ——
AUTH_SIGNUP_ENABLED=false

# —— OPC UA 服务端 ——
# ⚠ 这个端口段必须与 compose 里 opcua-server 的 ports 逐字一致：池外的端口
# 没有映射出去，实例会「显示运行中但连不上」，而状态还是「运行中」。
OPCUA_PORT_POOL=4840-4859
# 单进程内同时运行的实例数上限，必须 ≤ 端口池的容量（启动时会校验）。
OPCUA_MAX_INSTANCES=16

# —— 采集配置面（platform-server 的 apps/collect）——
# ⚠ 与 collector-server 的 COLLECT_EDGE_SERVICE_KEY 取同一个值：分叉就是
# collector 永远拉不到计划，而两侧代码单看都对。openssl rand -hex 32
PLATFORM_EDGE_SERVICE_KEY=
# ⚠ 数据源口令的加密密钥（≥32 字符），缺失即拒绝启动。openssl rand -hex 32
# 换钥后旧密文解不开：计划按未配置凭据下发并响亮记日志，界面上重填口令即恢复
COLLECT_CREDENTIAL_SECRET=
# 计划变更的广播频道。pub/sub 即发即弃，collector 仍按周期全量重拉兜底
PLATFORM_COLLECT_PLAN_CHANNEL=collect:plan:changed
# 浏览地址空间要往返一趟现场设备，预算比别的命令宽
PLATFORM_COLLECT_BROWSE_TIMEOUT_S=10.0
# 连通性测试、寻址串校验、下发写值共用的命令预算
PLATFORM_COLLECT_COMMAND_TIMEOUT_S=5.0
# 按天/月聚合的业务时区。⚠ 不带 timezone 的 time_bucket 按 UNIX 纪元对齐，
# 东八区的日桶会从当地 08:00 开始
PLATFORM_COLLECT_BUCKET_TIMEZONE=Asia/Shanghai

# —— 大屏实时发布（platform-server 的 publisher 角色）——
# ⚠ 这个部署单元**全局单活**：多起副本只会让它们抢同一把租约，抢不到的那个
# 是热备。它无 expose、无探针——不接流量的角色没有「摘掉它」这回事。
# 合并窗口（毫秒）：一拍读一次快照、推一批。节流归推送方，不归 hub
DASHBOARD_PUBLISH_WINDOW_MS=1000
# 单条推送的条目上限。⚠ 必须 ≤ realtime-hub 的条目上限（默认 500），
# 超了每一批都会被 413，而现象是「大屏偶尔一片不更新」
DASHBOARD_PUBLISH_MAX_ITEMS=200

# —— 采集运行时（collector-server）——
# ⚠ 这个容器必须跑在有工控网卡的宿主机上，且能路由到工控网段，见 ARCHITECTURE §7。
# 全量重拉采集计划并按版本号比对的周期（秒）。不用增量消息——丢一条就永久错位
COLLECT_PLAN_REFRESH_INTERVAL_S=30.0
# 快照落 Redis 的窗口（毫秒）。窗口内同一点位后值覆盖前值
COLLECT_FLUSH_INTERVAL_MS=300
# 快照哈希的存活期（秒），每次 flush 续。采集停了快照就过期，不留旧值冒充实时值
COLLECT_SNAPSHOT_TTL_S=60

# —— 素材字节面（对象存储，S3 协议；单机部署用 MinIO）——
# ⚠ 与 PostgreSQL / Redis 同档：它是**外部部署单元**，不由 compose 起停
# （ADR-0015）。它的数据目录与数据库同级纳入备份清单——素材没了，存量大屏里的
# 每一个 asset: 引用都会变成「取不到」。
# 访问密钥与私钥。⚠ 一份值三处用（对象存储自己的 root 凭据、建桶脚本、
# platform-server 的签名），分叉的表现是凭证签得出来、浏览器一传就 403
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=digitaltwin
# 服务端与建桶脚本到存储的地址，带 scheme
OSS_ENDPOINT=http://10.12.0.2:9000
# 边缘反代 /oss/ 的上游。⚠ 只能是 host:port——nginx 的 upstream 指令不认
# scheme，写了它 nginx 起不来，而它一起不来整个站都没了。
# ⚠ 与 OSS_ENDPOINT 必须指同一个实例：分叉的表现是凭证签得出来、浏览器一传
# 就 404，而两行的取值单看都对
OSS_UPSTREAM=10.12.0.2:9000
# 浏览器侧的直传与取回前缀，由边缘反代到桶根。⚠ 同一个值写在三处（这里、
# nginx 那条 location、前端 web/app/src/config/app.ts 的 ASSET_BASE_URL），
# 分叉的表现是上传 404 而模型加载不出来
OSS_PUBLIC_BASE=/oss/
