# 独立视觉模型访问密钥，未设置时继承对话密钥，null 恢复默认或继承。
# ASSISTANT_VISION_API_KEY=
# 独立视觉模型端点地址，留空继承对话端点。
# ASSISTANT_VISION_BASE_URL=
# 视觉模型额外请求体的 JSON 对象。
# ASSISTANT_VISION_EXTRA_BODY=
# 独立视觉模型代号，留空继承看图模型。
# ASSISTANT_VISION_MODEL=
# 独立视觉模型超时秒数，null 继承对话超时。
# ASSISTANT_VISION_TIMEOUT_S=null

# knowledge-server

# 关停时等待在途工作完成的秒数。
# KNOWLEDGE_APP_DRAIN_TIMEOUT_S=20.0
# HTTP 服务监听地址，由 Compose 管理。
# KNOWLEDGE_APP_HTTP_HOST=0.0.0.0
# HTTP 服务监听端口，由 Compose 管理。
# KNOWLEDGE_APP_HTTP_PORT=8009
# 日志中的实例标识，未设置时使用容器主机名。
# KNOWLEDGE_APP_INSTANCE=
# 日志输出格式。
# KNOWLEDGE_APP_LOG_FORMAT=json
# 日志输出级别。
# KNOWLEDGE_APP_LOG_LEVEL=INFO
# 日志中的服务名称，由 Compose 管理。
# KNOWLEDGE_APP_NAME=knowledge-server
# 当前进程的运行角色，由 Compose 管理。
# KNOWLEDGE_APP_ROLE=api
# 正常请求链路的采样比例。
# KNOWLEDGE_APP_TRACE_SAMPLE_RATIO=0.1
# FunASR WebSocket 连接超时秒数。
# KNOWLEDGE_ASR_CONNECT_TIMEOUT_S=5.0
# 是否启用 FunASR 语音输入。
# KNOWLEDGE_ASR_ENABLED=false
# 语音输入等待最终转写的超时秒数。
# KNOWLEDGE_ASR_FINAL_TIMEOUT_S=5.0
# 传给 FunASR 的热词内容。
# KNOWLEDGE_ASR_HOTWORDS=
# 语音输入连接空闲超时秒数。
# KNOWLEDGE_ASR_IDLE_TIMEOUT_S=30.0
# 单次语音输入最大持续秒数。
# KNOWLEDGE_ASR_MAX_UTTERANCE_S=60.0
# 语音输入结束后补充的尾部静音秒数。
# KNOWLEDGE_ASR_TAIL_SILENCE_S=3.0
# FunASR 的 ws 或 wss 地址。
# KNOWLEDGE_ASR_URL=
# 知识库切块最小 token 数量。
# KNOWLEDGE_CHUNK_MIN_TOKENS=80
# 知识库相邻块重叠字符数量。
# KNOWLEDGE_CHUNK_OVERLAP_CHARS=120
# 内部接口的共享服务密钥，必填且至少 32 字符，由 AUTH_EDGE_SERVICE_KEY 注入。
# KNOWLEDGE_EDGE_SERVICE_KEY=
# 边缘身份头的共享签名密钥，必填且至少 32 字符，由 AUTH_EDGE_SIGNING_SECRET 注入。
# KNOWLEDGE_EDGE_SIGNING_SECRET=
# 嵌入模型访问密钥，启用嵌入时必填，null 恢复默认或继承。
# KNOWLEDGE_EMBEDDING_API_KEY=
# OpenAI 兼容嵌入模型端点地址。
# KNOWLEDGE_EMBEDDING_BASE_URL=
# 嵌入模型单次批处理的块数量。
# KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
# 嵌入向量维数，知识库须与迁移和模型维数一致。
# KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# 是否启用环境变量配置的嵌入模型。
# KNOWLEDGE_EMBEDDING_ENABLED=false
# 嵌入模型单块输入 token 上限。
# KNOWLEDGE_EMBEDDING_MAX_INPUT_TOKENS=512
# 嵌入模型代号。
# KNOWLEDGE_EMBEDDING_MODEL=
# 嵌入模型请求超时秒数。
# KNOWLEDGE_EMBEDDING_TIMEOUT_S=30.0
# MinerU 投递与轮询的总超时秒数。
# KNOWLEDGE_EXTERNAL_PARSE_TIMEOUT_S=180.0
# 每次拉取的知识库摄取任务数量。
# KNOWLEDGE_INGEST_BATCH=1
# 知识库摄取任务拉取阻塞毫秒数。
# KNOWLEDGE_INGEST_BLOCK_MS=5000
# 知识库摄取任务重新认领门槛毫秒数。
# KNOWLEDGE_INGEST_CLAIM_IDLE_MS=300000
# 是否写入摄取期次，新旧 worker 切换完成后再开启。
# KNOWLEDGE_INGEST_GENERATION_WRITE_ENABLED=false
# 知识库摄取任务的消费组名称。
# KNOWLEDGE_INGEST_GROUP=knowledge-ingest-workers
# 知识库摄取任务的 Redis Stream 名称。
# KNOWLEDGE_INGEST_STREAM=knowledge:ingest
# 单份知识库文档摄取总超时秒数。
# KNOWLEDGE_INGEST_TIMEOUT_S=1800
# 模型供应商目录刷新间隔秒数。
# KNOWLEDGE_LLM_CATALOG_REFRESH_S=10.0
# 模型供应商目录拉取超时秒数。
# KNOWLEDGE_LLM_CATALOG_TIMEOUT_S=3.0
# 领取订阅模型短期令牌的超时秒数。
# KNOWLEDGE_LLM_LOGIN_TIMEOUT_S=15.0
# MinerU 外部解析服务地址。
# KNOWLEDGE_MINERU_BASE_URL=http://mineru:8000
# 是否启用 MinerU 解析 PDF 与扫描件。
# KNOWLEDGE_MINERU_ENABLED=false
# 是否启用 MinerU 公式识别。
# KNOWLEDGE_MINERU_FORMULA_ENABLED=true
# MinerU OCR 语言代号。
# KNOWLEDGE_MINERU_LANG=ch
# 是否启用 MinerU 表格识别。
# KNOWLEDGE_MINERU_TABLE_ENABLED=true
# 对话模型访问密钥，启用模型时必填，null 恢复默认或继承。
# KNOWLEDGE_MODEL_API_KEY=
# OpenAI 兼容对话模型端点地址。
# KNOWLEDGE_MODEL_BASE_URL=
# 模型断路器开启前的连续失败次数。
# KNOWLEDGE_MODEL_BREAKER_FAILURES=5
# 模型断路器重新探测间隔秒数。
# KNOWLEDGE_MODEL_BREAKER_RESET_S=30.0
# 对话模型代号。
# KNOWLEDGE_MODEL_CHAT=
# 对话模型实际上下文 token 上限，0 表示未知。
# KNOWLEDGE_MODEL_CONTEXT_TOKENS=0
# 是否启用环境变量配置的对话模型。
# KNOWLEDGE_MODEL_ENABLED=false
# 对话模型单次请求超时秒数。
# KNOWLEDGE_MODEL_TIMEOUT_S=60.0
# 对象存储访问密钥，由 OSS_ACCESS_KEY 注入。
# KNOWLEDGE_OBJECTSTORE_ACCESS_KEY=
# 对象存储桶名称，由 OSS_BUCKET 注入。
# KNOWLEDGE_OBJECTSTORE_BUCKET=
# 对象存储连接超时秒数。
# KNOWLEDGE_OBJECTSTORE_CONNECT_TIMEOUT_S=3.0
# 服务端访问对象存储的完整地址，由 OSS_ENDPOINT 注入。
# KNOWLEDGE_OBJECTSTORE_ENDPOINT=
# 对象存储单次操作的尝试次数上限。
# KNOWLEDGE_OBJECTSTORE_MAX_ATTEMPTS=2
# 是否按路径方式访问 S3 存储桶。
# KNOWLEDGE_OBJECTSTORE_PATH_STYLE_ENABLED=true
# 浏览器访问对象存储的路径前缀，由 OSS_PUBLIC_BASE 注入。
# KNOWLEDGE_OBJECTSTORE_PUBLIC_BASE=
# 对象存储读取超时秒数。
# KNOWLEDGE_OBJECTSTORE_READ_TIMEOUT_S=10.0
# S3 签名使用的区域名称。
# KNOWLEDGE_OBJECTSTORE_REGION=us-east-1
# 对象存储签名密钥，由 OSS_SECRET_KEY 注入。
# KNOWLEDGE_OBJECTSTORE_SECRET_KEY=
# DOCX 原件 PDF 预览转换命令。
# KNOWLEDGE_OFFICE_PREVIEW_COMMAND=soffice
# 是否用 LibreOffice 生成 DOCX 原件 PDF 预览。
# KNOWLEDGE_OFFICE_PREVIEW_ENABLED=true
# DOCX 原件 PDF 预览转换超时秒数。
# KNOWLEDGE_OFFICE_PREVIEW_TIMEOUT_S=300
# 单份知识库文档本地解析超时秒数。
# KNOWLEDGE_PARSE_TIMEOUT_S=600
# 业务平台的内部 HTTP 地址。
# KNOWLEDGE_PLATFORM_BASE_URL=http://platform-server:8005
# 业务平台请求超时秒数。
# KNOWLEDGE_PLATFORM_TIMEOUT_S=10.0
# PostgreSQL 连接超时秒数。
# KNOWLEDGE_POSTGRES_CONNECT_TIMEOUT_S=5.0
# PostgreSQL 数据库名，由 POSTGRES_DB 注入。
# KNOWLEDGE_POSTGRES_DB=
# PostgreSQL 主机地址，由 POSTGRES_HOST 注入。
# KNOWLEDGE_POSTGRES_HOST=
# PostgreSQL 等待锁的超时毫秒数。
# KNOWLEDGE_POSTGRES_LOCK_TIMEOUT_MS=3000
# PostgreSQL 登录密码，由 POSTGRES_PASSWORD 注入。
# KNOWLEDGE_POSTGRES_PASSWORD=
# PostgreSQL 额外连接数上限。
# KNOWLEDGE_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# KNOWLEDGE_POSTGRES_POOL_SIZE=10
# PostgreSQL 端口，由 POSTGRES_PORT 注入。
# KNOWLEDGE_POSTGRES_PORT=
# 当前服务拥有的数据库 schema，由 Compose 管理。
# KNOWLEDGE_POSTGRES_SCHEMA=knowledge
# PostgreSQL 语句超时毫秒数。
# KNOWLEDGE_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 登录账号，由 POSTGRES_USER 注入。
# KNOWLEDGE_POSTGRES_USER=
# Redis 数据库编号。
# KNOWLEDGE_REDIS_DB=0
# Redis 主机地址，由 REDIS_HOST 注入。
# KNOWLEDGE_REDIS_HOST=
# Redis 登录密码，无密码时不设置，由 REDIS_PASSWORD 注入。
# KNOWLEDGE_REDIS_PASSWORD=
# Redis 端口，由 REDIS_PORT 注入。
# KNOWLEDGE_REDIS_PORT=
# Redis 请求超时秒数。
# KNOWLEDGE_REDIS_TIMEOUT_S=1.0
# 知识库重排模型请求超时秒数。
# KNOWLEDGE_RERANK_TIMEOUT_S=15.0
