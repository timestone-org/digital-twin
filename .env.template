# PostgreSQL 登录密码，由 POSTGRES_PASSWORD 注入。
# PLATFORM_POSTGRES_PASSWORD=
# PostgreSQL 额外连接数上限。
# PLATFORM_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# PLATFORM_POSTGRES_POOL_SIZE=10
# PostgreSQL 端口，由 POSTGRES_PORT 注入。
# PLATFORM_POSTGRES_PORT=
# 当前服务拥有的数据库 schema，由 Compose 管理。
# PLATFORM_POSTGRES_SCHEMA=platform
# PostgreSQL 语句超时毫秒数。
# PLATFORM_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 登录账号，由 POSTGRES_USER 注入。
# PLATFORM_POSTGRES_USER=
# 实时发布单活租约有效期秒数。
