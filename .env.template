# Docker 环境变量模板，复制到 docker/.env 后填写必填项。
# 可选项取消注释后生效；密钥留空，nullable 项写 null 可恢复默认或继承。
# Compose 管理的拓扑项仅展示，不从 docker/.env 覆盖。

# 部署入口

# 应用镜像标签，部署时使用版本号加提交 SHA。
# IMAGE_TAG=dev
# 边缘网关对宿主开放的 HTTP 端口。
# EDGE_HTTP_PORT=8080
# PostgreSQL 主机地址，必填。
POSTGRES_HOST=
# PostgreSQL 端口。
# POSTGRES_PORT=5432
# PostgreSQL 应用登录账号，必填。
POSTGRES_USER=
# PostgreSQL 应用登录密码，必填。
POSTGRES_PASSWORD=
# PostgreSQL 数据库名，必填。
POSTGRES_DB=
# Redis 主机地址，必填。
REDIS_HOST=
# Redis 端口。
# REDIS_PORT=6379
# Redis 登录密码，无密码时保持注释。
# REDIS_PASSWORD=
# 只读 EMS SQL Server 主机地址，必填。
ACSOURCE_HOST=
# 只读 EMS SQL Server 端口。
# ACSOURCE_PORT=1433
# 只读 EMS SQL Server 登录账号，必填。
ACSOURCE_USER=
# 只读 EMS SQL Server 登录密码，必填。
ACSOURCE_PASSWORD=
# 只读 EMS SQL Server 数据库名，必填。
ACSOURCE_DB=
# EMS 无时区时间列使用的业务时区。
# ACSOURCE_TIMEZONE=Asia/Shanghai
# EMS 客户端字符集，中文旧库通常使用 CP936。
# ACSOURCE_CHARSET=UTF-8
# JWT 主签名密钥，必填且至少 32 字符。
AUTH_JWT_SECRET=
# 边缘身份头共享签名密钥，必填且至少 32 字符。
AUTH_EDGE_SIGNING_SECRET=
# 内部接口共享服务密钥，必填且至少 32 字符。
AUTH_EDGE_SERVICE_KEY=
# 采集凭据加密密钥，必填且至少 32 字符。
COLLECT_CREDENTIAL_SECRET=
# 模型供应商凭据加密密钥，启用目录时填写至少 32 字符。
# LLM_PROVIDER_SECRET=
# 服务端访问对象存储的完整地址，必填。
OSS_ENDPOINT=
# 边缘对象存储上游 host:port，必填且不带协议。
OSS_UPSTREAM=
# 对象存储桶名称。
# OSS_BUCKET=digitaltwin
# 对象存储访问密钥，必填。
OSS_ACCESS_KEY=
# 对象存储签名密钥，必填。
OSS_SECRET_KEY=
# 浏览器对象存储路径前缀，须与边缘路由一致。
# OSS_PUBLIC_BASE=/oss/

# 统一迁移与首次管理员

# 迁移专用 PostgreSQL 账号，未设置时沿用应用账号，独立账号须先配置业务访问权限。
# MIGRATION_POSTGRES_USER=
# 迁移专用 PostgreSQL 密码，未设置时使用 POSTGRES_PASSWORD。
# MIGRATION_POSTGRES_PASSWORD=
# 统一迁移等待 PostgreSQL 可连接的超时秒数。
# MIGRATION_DATABASE_WAIT_TIMEOUT_S=120
# 每条迁移或种子命令的超时秒数。
# MIGRATION_COMMAND_TIMEOUT_S=600
# 首次创建管理员使用的用户名。
# AUTH_SEED_ADMIN_USERNAME=admin
# 首次创建管理员使用的邮箱。
# AUTH_SEED_ADMIN_EMAIL=admin@example.com
# 首次创建管理员使用的密码，必填且不修改已有管理员。
AUTH_SEED_ADMIN_PASSWORD=

# 兼容已有部署的别名

# 开机事件分片任务流名称，PLATFORM_ACSTARTUP_STREAM 优先。
# ACSTARTUP_STREAM=platform:ac-startup:shards
# 开机事件分片消费组名称，PLATFORM_ACSTARTUP_GROUP 优先。
# ACSTARTUP_GROUP=ac-startup-workers
# 采集计划变更广播频道，PLATFORM_COLLECT_PLAN_CHANNEL 优先。
# COLLECT_PLAN_CHANNEL=collect:plan:changed
# 点位历史聚合时区，PLATFORM_COLLECT_BUCKET_TIMEZONE 优先。
# COLLECT_BUCKET_TIMEZONE=Asia/Shanghai
# 大屏实时推送窗口毫秒数，PLATFORM_PUBLISH_WINDOW_MS 优先。
# DASHBOARD_PUBLISH_WINDOW_MS=2000
# 大屏单次实时推送条目上限，PLATFORM_PUBLISH_MAX_ITEMS 优先。
# DASHBOARD_PUBLISH_MAX_ITEMS=200
# 台账日历分桶时区，PLATFORM_DATASET_BUCKET_TIMEZONE 优先。
# DATASET_BUCKET_TIMEZONE=Asia/Shanghai
# 台账周期聚合开关，PLATFORM_DATASET_ENABLED 优先。
# DATASET_ENABLED=false
# 台账周期聚合间隔秒数，PLATFORM_DATASET_INTERVAL_S 优先。
# DATASET_INTERVAL_S=60.0
# 台账最近重算桶数量，PLATFORM_DATASET_RECOMPUTE_TAIL_BUCKETS 优先。
# DATASET_RECOMPUTE_TAIL_BUCKETS=2
# 台账单表每轮桶数量上限，PLATFORM_DATASET_MAX_BUCKETS_PER_TICK 优先。
# DATASET_MAX_BUCKETS_PER_TICK=240
# 台账单表每轮超时秒数，PLATFORM_DATASET_TABLE_TIMEOUT_S 优先。
# DATASET_TABLE_TIMEOUT_S=60.0
# 台账聚合租约有效期秒数，PLATFORM_DATASET_LEASE_TTL_S 优先。
# DATASET_LEASE_TTL_S=180

# 外部解析与前端构建

# MinerU 权重下载来源，仅 mineru profile 使用。
# MINERU_MODEL_SOURCE=modelscope
# 前端自动订阅点位卡片上限，需传给前端构建命令。
# VITE_KNOWLEDGE_CHAT_MAX_ACTIVE_LIVE_CARDS=20
# Vite 开发代理 API 地址，仅前端开发服务器使用。
# VITE_DEV_API_TARGET=http://127.0.0.1:8080
# Nginx 模板替换白名单，由 Compose 固定管理。
# NGINX_ENVSUBST_FILTER=^(AUTH_|OSS_)
# Nginx 模板输出目录，由 Compose 固定管理。
# NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx

# auth-server

# API 密钥最近使用时间的写库间隔秒数。
# AUTH_API_KEY_TOUCH_INTERVAL_S=60
# API 密钥散列验证缓存有效期秒数。
# AUTH_API_KEY_VERIFY_CACHE_TTL_S=60
# 关停时等待在途工作完成的秒数。
# AUTH_APP_DRAIN_TIMEOUT_S=20.0
# HTTP 服务监听地址，由 Compose 管理。
# AUTH_APP_HTTP_HOST=0.0.0.0
# HTTP 服务监听端口，由 Compose 管理。
# AUTH_APP_HTTP_PORT=8004
# 日志中的实例标识，未设置时使用容器主机名。
# AUTH_APP_INSTANCE=
# 日志输出格式。
# AUTH_APP_LOG_FORMAT=json
# 日志输出级别。
# AUTH_APP_LOG_LEVEL=INFO
# 日志中的服务名称，由 Compose 管理。
# AUTH_APP_NAME=auth-server
# 当前进程的运行角色，由 Compose 管理。
# AUTH_APP_ROLE=api
# 正常请求链路的采样比例。
# AUTH_APP_TRACE_SAMPLE_RATIO=0.1
# 边缘权限缓存有效期秒数。
# AUTH_EDGE_PERMISSION_TTL_S=60
# 登录 access token 有效期秒数，保持 900。
# AUTH_JWT_ACCESS_TTL_S=900
# JWT 签发者名称。
# AUTH_JWT_ISSUER=auth-server
# JWT 轮换期间保留的旧签名密钥，null 恢复默认或继承。
# AUTH_JWT_PREVIOUS_SECRET=
# 登录 refresh token 有效期秒数。
# AUTH_JWT_REFRESH_TTL_S=1209600
# 登录限流窗口内的尝试次数上限。
# AUTH_LOGIN_MAX_ATTEMPTS=10
# 登录限流窗口秒数。
# AUTH_LOGIN_WINDOW_S=300
# PostgreSQL 连接超时秒数。
# AUTH_POSTGRES_CONNECT_TIMEOUT_S=5.0
# PostgreSQL 数据库名，由 POSTGRES_DB 注入。
# AUTH_POSTGRES_DB=
# PostgreSQL 主机地址，由 POSTGRES_HOST 注入。
# AUTH_POSTGRES_HOST=
# PostgreSQL 等待锁的超时毫秒数。
# AUTH_POSTGRES_LOCK_TIMEOUT_MS=3000
# PostgreSQL 登录密码，由 POSTGRES_PASSWORD 注入。
# AUTH_POSTGRES_PASSWORD=
# PostgreSQL 额外连接数上限。
# AUTH_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# AUTH_POSTGRES_POOL_SIZE=10
# PostgreSQL 端口，由 POSTGRES_PORT 注入。
# AUTH_POSTGRES_PORT=
# 当前服务拥有的数据库 schema，由 Compose 管理。
# AUTH_POSTGRES_SCHEMA=auth
# PostgreSQL 语句超时毫秒数。
# AUTH_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 登录账号，由 POSTGRES_USER 注入。
# AUTH_POSTGRES_USER=
# Redis 数据库编号。
# AUTH_REDIS_DB=0
# Redis 主机地址，由 REDIS_HOST 注入。
# AUTH_REDIS_HOST=
# Redis 登录密码，无密码时不设置，由 REDIS_PASSWORD 注入。
# AUTH_REDIS_PASSWORD=
# Redis 端口，由 REDIS_PORT 注入。
# AUTH_REDIS_PORT=
# Redis 请求超时秒数。
# AUTH_REDIS_TIMEOUT_S=1.0
# 注册账号的初始角色名称。
# AUTH_SIGNUP_DEFAULT_ROLE=viewer
# 是否开放账号注册。
# AUTH_SIGNUP_ENABLED=false
# 注册限流窗口内的尝试次数上限。
# AUTH_SIGNUP_MAX_ATTEMPTS=5
# 注册限流窗口秒数。
# AUTH_SIGNUP_WINDOW_S=3600

# platform-server

# 开机事件每日增量任务拉取阻塞毫秒数。
