# 手动迁移作业模板，复制为 server/deploy/.env 并由 uv run --env-file 加载。
# 属主的服务配置和管理员种子参数读取各自服务目录下的 .env。

# PostgreSQL 主机名或地址，需从运行迁移的主机可达。
POSTGRES_HOST=127.0.0.1
# PostgreSQL 连接端口，须与实际宿主发布端口一致。
# POSTGRES_PORT=5432
# 执行 DDL 和安装扩展的 PostgreSQL 账号，按部署规划填写。
POSTGRES_USER=postgres
# PostgreSQL 迁移账号的登录口令，必填。
POSTGRES_PASSWORD=
# 应用各 schema 所在的 PostgreSQL 数据库。
POSTGRES_DB=dt_db
# 等候 PostgreSQL 就绪的总预算，单位秒。
# MIGRATION_DATABASE_WAIT_TIMEOUT_S=120
# 每条迁移或种子子进程命令的超时，单位秒。
# MIGRATION_COMMAND_TIMEOUT_S=600
