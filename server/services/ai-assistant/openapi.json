  "info": {
    "title": "DigitalTwin AI Assistant",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assistant/capabilities": {
      "get": {
        "description": "模型是否可用，以及本部署装了哪些技能。\n\nArgs: container, _caller。",
        "operationId": "read_capabilities_api_v1_assistant_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_CapabilityOut_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "助手能力",
        "tags": [
          "capability"
        ]
      }
    },
    "/api/v1/assistant/health": {
      "get": {
        "operationId": "health_api_v1_assistant_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "存活探针",
        "tags": [
          "probe"
        ]
      }
    },
    "/api/v1/assistant/ready": {
      "get": {
        "operationId": "ready_api_v1_assistant_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "就绪探针",
        "tags": [
          "probe"
        ]
      }
    },
    "/api/v1/assistant/sessions": {
      "get": {
        "description": "分页列出调用者看得见的会话。\n\nArgs: session, page, caller, filters。",
        "operationId": "list_sessions_api_v1_assistant_sessions_get",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "surface_kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "dashboard-editor",
                    "twin-editor",
                    "dataset-table",
                    "collect-source",
                    "dashboard-view"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Surface Kind"
            }
          },
          {
            "in": "query",
            "name": "is_archived",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Is Archived"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_Page_SessionOut__"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "会话列表",
        "tags": [
          "chat-session"
        ]
      },
      "post": {
        "description": "建会话。支持 `Idempotency-Key`。\n\nArgs: payload, session, response, write。",
        "operationId": "create_session_api_v1_assistant_sessions_post",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_SessionOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
