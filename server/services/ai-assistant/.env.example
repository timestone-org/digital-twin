# ai-assistant 本地开发用的环境变量。密钥类留空，**必填**。
# ⚠ 本文件可以提交；填好取值的 .env 不许进版本库。

# —— 进程 ——
ASSISTANT_APP_NAME=ai-assistant
ASSISTANT_APP_ROLE=api
ASSISTANT_APP_INSTANCE=
ASSISTANT_APP_LOG_LEVEL=INFO
ASSISTANT_APP_LOG_FORMAT=text
ASSISTANT_APP_HTTP_HOST=0.0.0.0
ASSISTANT_APP_HTTP_PORT=8006
# 优雅关停时等待在途回合的上限，必须小于编排器的宽限期
ASSISTANT_APP_DRAIN_TIMEOUT_S=20
ASSISTANT_APP_TRACE_SAMPLE_RATIO=0.1

# —— PostgreSQL ——
ASSISTANT_POSTGRES_HOST=127.0.0.1
ASSISTANT_POSTGRES_PORT=5432
ASSISTANT_POSTGRES_USER=
ASSISTANT_POSTGRES_PASSWORD=
ASSISTANT_POSTGRES_DB=
ASSISTANT_POSTGRES_SCHEMA=assistant
ASSISTANT_POSTGRES_POOL_SIZE=10
ASSISTANT_POSTGRES_POOL_OVERFLOW=5
ASSISTANT_POSTGRES_CONNECT_TIMEOUT_S=5
ASSISTANT_POSTGRES_STATEMENT_TIMEOUT_MS=2000
ASSISTANT_POSTGRES_LOCK_TIMEOUT_MS=3000

# —— Redis ——
ASSISTANT_REDIS_HOST=127.0.0.1
ASSISTANT_REDIS_PORT=6379
ASSISTANT_REDIS_PASSWORD=
ASSISTANT_REDIS_DB=0
ASSISTANT_REDIS_TIMEOUT_S=1

# —— 边缘密钥（与 auth-server 同值）——
# ⚠ 两者都必须与 auth-server 那边逐字相同：不同的话表现是一律 401/403，
# 而两边配置单看都对。生成：openssl rand -hex 32
ASSISTANT_EDGE_SIGNING_SECRET=
ASSISTANT_EDGE_SERVICE_KEY=

# —— 模型 ——
# 总开关。关着时服务照常起、会话照常读，只是发不出新回合——这是「现场没有
# 外网」时的正解，不要用改代码或删服务的方式关。
ASSISTANT_MODEL_ENABLED=false
# OpenAI 兼容端点。换供应商只改这一项，代码里不认任何厂商名。
# ⚠ 这是 legacy 域名，仍可用。供应商现在推业务空间专属域名，形如
#   https://{业务空间id}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ⚠ 国内与国际站的密钥不通用，域名与密钥要成对换。
ASSISTANT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ⚠ 开关为真时必填，否则**启动即失败**（不是等到第一次对话才报）
ASSISTANT_MODEL_API_KEY=
# 对话模型与看图模型。当前旗舰原生吃图，两项给同一个值是常态；分开留着是为了
# 让「看图那一路换成更便宜的专用模型」成为一次配置改动而不是一次发版。
ASSISTANT_MODEL_CHAT=qwen3.8-max
ASSISTANT_MODEL_VISION=qwen3.8-max
# 折叠窗口外那一截用的模型。留空即用 ASSISTANT_MODEL_CHAT。
# 端点与密钥不单配——折叠是后台性质的一次调用，跟着对话档走就够了
ASSISTANT_SUMMARY_MODEL=
# 逐字流式。关掉的话，用户在整个回合里只看得见「做了哪一步」，模型说的那段话
# 要等回合结束才整段出现，而它想的十几秒是纯黑箱。留成配置只为一种场合：
# 个别 OpenAI 兼容端点在带工具时不支持流式，那时表现是一条 400。
ASSISTANT_MODEL_STREAM_ENABLED=true
# 透传给端点的额外请求体（JSON 对象）。思考过程一类的开关在 OpenAI 兼容口径里
# 没有标准字段、各家用自己的键，而代码里不认厂商名——于是它只能是取值。
# 留空即什么都不加；例：{"enable_thinking": true}
ASSISTANT_MODEL_EXTRA_BODY=
# 一次模型调用的上限。⚠ 它比边缘的通用读超时长，所以流式端点不走那条通用配置
ASSISTANT_MODEL_TIMEOUT_S=120
# 断路器：连续失败到这个次数就短路，过了冷却期再放探测请求。
# ⚠ 每一格 (档位, 用途) 各有一份，互不牵连——看图那一档挂了不该把对话一起短路
ASSISTANT_MODEL_BREAKER_FAILURES=5
ASSISTANT_MODEL_BREAKER_RESET_S=30

# 看图那一档的**独立端点**。整组留空即逐格回落到上面对话档那一组——
# 存在的理由是「对话走一家、看图走另一家」：共用一个 base_url 时，
# 换看图供应商只能连对话一起换。
ASSISTANT_VISION_BASE_URL=
# ⚠ 配了上面那个**另一家**端点时这一格必填，否则启动即失败：回落会拿对话档
# 那一把密钥去打另一家的端点，每次看图都撞 401，而那一档刻意不打开断路器，
# 于是每次都要等一个完整往返才失败。现象是「截图功能时好时坏」。
# 留空且端点也留空时，回落的是对话档那一把密钥，不是空串。
ASSISTANT_VISION_API_KEY=
# 留空即用 ASSISTANT_MODEL_VISION
ASSISTANT_VISION_MODEL=
# 不覆盖就用 ASSISTANT_MODEL_TIMEOUT_S。看图那一档的延迟本来就高得多，
# 共用一格意味着要么对话档等得过久、要么视觉档被过早掐断。
# ⚠ 这一格只有两种写法：写一个数，或者**整行注释掉**。写成 `=`（空串）是
# 启动即失败——空串解析不成数字，而「留空」在别的格子上是合法的
# ASSISTANT_VISION_TIMEOUT_S=
# 留空即用 ASSISTANT_MODEL_EXTRA_BODY。两档不同家时方言键必然不同
ASSISTANT_VISION_EXTRA_BODY=

# —— 嵌入那一路（可选，默认关）——
# 长期记忆按它把文本转成向量（ADR-0030）。⚠ 全留空即本部署没接嵌入：
# 助手**仍然记得住**（存文本、标没有向量），只是检索用不了——工具的回执会
# 如实说这件事。接上之后下一次检索会把之前没算的那些自动补算。
# 留空即用 ASSISTANT_MODEL_BASE_URL
ASSISTANT_EMBEDDING_BASE_URL=
# ⚠ 配了上面那个**另一家**端点时这一格必填，否则启动即失败：回落会拿对话档
# 那把密钥打另一家端点，每次 remember 都撞 401，而降级路径会把它吞成
# 「这条暂时检索不到」——现象是「记是记住了，就是永远查不到」。
ASSISTANT_EMBEDDING_API_KEY=
# ⚠ **没有兜底**：留空即这一路没接。嵌入模型与对话模型不通用，拿对话模型名
# 去打 embeddings 端点是一条必然失败的调用。
ASSISTANT_EMBEDDING_MODEL=
# 向量维数。⚠ 落库前拿它核对端点回来的长度：换了模型而维数变了的话，旧条目与
# 新条目算不出有意义的余弦，而表现只是「召回忽然变差了」。
ASSISTANT_EMBEDDING_DIMENSIONS=1536
# 不覆盖就用 ASSISTANT_MODEL_TIMEOUT_S。
# ⚠ 同上：写数字或整行注释掉，写成 `=` 是启动即失败
# ASSISTANT_EMBEDDING_TIMEOUT_S=

# —— 订阅账号那一路（可选，默认关）——
# 用 ChatGPT 订阅直连 Codex 后端，而不是按 token 付费的 API Key。与上面那一路
# 并存：两边都配好时由会话自己选用哪一个。
# ⚠ 这条路走的是**未公开接口**，供应商随时可能改；开它之前请自己确认账号、
# 工作区、订阅与适用条款允许这么用——上游库自己也把这套标成 experimental。
ASSISTANT_CODEX_ENABLED=false
# 走这条路时用哪个模型代号。⚠ 开关为真时必填，否则启动即失败：代号随供应商
# 发版变，写死一个没验证过的名字，表现是每次对话都撞一条 404。
# 取值去 codex CLI 的模型列表或供应商文档确认。
ASSISTANT_CODEX_MODEL=
# 面板上还能选哪几个，逗号分隔；留空就只有上面那一个
ASSISTANT_CODEX_MODELS=
# 推理档位：low / medium / high / xhigh。配错了启动即失败
ASSISTANT_CODEX_REASONING_EFFORT=medium
# 模型账号令牌的加密密钥（≥32 字符）。⚠ 开关为真时必填，否则启动即失败。
# ⚠ 换掉它 = 库里那一行解不开 = 界面上变成「没登录过」，要重新登录一次。
ASSISTANT_CREDENTIAL_SECRET=

# —— 上游 ——
ASSISTANT_PLATFORM_BASE_URL=http://127.0.0.1:8005
ASSISTANT_PLATFORM_TIMEOUT_S=5
# 模型目录（ADR-0039）：从 platform 内部面拉「各用途走哪一路模型」，认证用
# 上面那把 ASSISTANT_EDGE_SERVICE_KEY。⚠ 上面 ASSISTANT_MODEL_* 那一组是它的
# 永久默认值：目录里没给某个用途分配时才用环境变量那一档。多久重拉一次；
# 拉不到就沿用上一份
ASSISTANT_LLM_CATALOG_REFRESH_S=10
ASSISTANT_LLM_CATALOG_TIMEOUT_S=3
# auth-server 的内部面。⚠ 只用来给长回合的委托身份续签：边缘签的身份头只有
# 几十秒，而一个回合能跑几分钟——填错这一格的现象是「回合前半段好好的，
# 后半段每个工具都报 platform 回了 401」，而 platform 本身是好的
ASSISTANT_AUTH_BASE_URL=http://127.0.0.1:8004
ASSISTANT_AUTH_TIMEOUT_S=3

# —— 外部 MCP 工具（ADR-0031）——
# 一段 JSON 列表，逐项 {"name":"...","url":"https://...","is_auth_required":true}。
# ⚠ **只收 http/https**：MCP 还有 stdio 传输，这套部署不接它——那一档要每个副本
# 起一个子进程，而 api 角色无状态且要水平扩。配了别的传输的项会被整体判空。
# ⚠ 令牌**不许拼进 url**：url 会进日志、进链路追踪、进错误消息。
ASSISTANT_MCP_SERVERS=
# 各路的令牌，一段 JSON 对象 {"server 名":"令牌"}。⚠ 某一路 is_auth_required 为真
# 却没在这里配它，启动即失败——留到运行期的话，那一路每次都撞 401、断路器打开，
# 现象是「这一路的工具时有时无」，而它指不回这一格。
ASSISTANT_MCP_TOKENS=
# 许下发的**写操作**规范名，一段 JSON 字符串列表，如 ["mcp.weather.set_alert"]。
# ⚠ 默认空 = 只下发 server 明说只读的那些。MCP 的 readOnlyHint 是可选的，缺了
# 那一格的工具可能删东西，所以说不清就当写操作、不下发：放行的代价不可逆，
# 拦下的代价只是在这里补一行。
ASSISTANT_MCP_WRITE_ALLOWED=
ASSISTANT_MCP_TIMEOUT_S=10
# 一路连续失败多少次就断它。⚠ 按 server 分，一路挂掉不影响其余几路
ASSISTANT_MCP_BREAKER_FAILURES=3
ASSISTANT_MCP_BREAKER_RESET_S=60

# ---- 知识库读侧 ----
# ⚠ 留空即这套部署**没接知识库**：「查知识库」那两个工具照样在规格表里
# （不然「装配期看得见、运行期看不见」两份清单会漂开），调用时抛一句
# 点得出名字的错。不留空但服务没起时是另一回事——那时如实报「暂时不可用」
ASSISTANT_KNOWLEDGE_BASE_URL=http://knowledge-server:8009
ASSISTANT_KNOWLEDGE_TIMEOUT_S=20.0
