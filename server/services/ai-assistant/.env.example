# ai-assistant 手动部署模板，复制为服务目录下的 .env（UTF-8 无 BOM）。
# 请填写必填连接与密钥；可选项按需取消注释，进程环境覆盖同名配置。

# —— 进程 ——
# 服务名，用于日志、指标和诊断。
ASSISTANT_APP_NAME=ai-assistant
# AI 助手的 HTTP API 运行角色，使用 api。
ASSISTANT_APP_ROLE=api
# 进程实例名，用于日志和诊断；同一部署中各进程应取不同值。
ASSISTANT_APP_INSTANCE=dt-assistant
# 日志级别，可设 DEBUG、INFO、WARNING、ERROR 或 CRITICAL。
ASSISTANT_APP_LOG_LEVEL=INFO
# 日志输出格式，部署默认使用 json。
ASSISTANT_APP_LOG_FORMAT=json
# HTTP 监听地址；同机网关可使用回环地址。
ASSISTANT_APP_HTTP_HOST=127.0.0.1
# HTTP 监听端口；须与网关或调用方所配的端口一致。
ASSISTANT_APP_HTTP_PORT=8006
# 关停排空预算，单位秒；须小于 NSSM 停止等待时间。
ASSISTANT_APP_DRAIN_TIMEOUT_S=20
# HTTP 摘除就绪后继续监听的秒数。
ASSISTANT_APP_READINESS_WITHDRAW_S=2.0

# —— PostgreSQL ——
# 共享 PostgreSQL 实例的连接地址。
ASSISTANT_POSTGRES_HOST=127.0.0.1
# PostgreSQL 连接端口，手动运行时填写实际宿主发布端口。
ASSISTANT_POSTGRES_PORT=5432
# 必填数据库账号与口令；各服务共用同一实例和数据库。
ASSISTANT_POSTGRES_USER=postgres
# PostgreSQL 登录口令，必填。
ASSISTANT_POSTGRES_PASSWORD=
# 项目共享的 PostgreSQL 数据库名，须与其他服务一致。
ASSISTANT_POSTGRES_DB=dt_db
# 本服务持有的数据库 schema，须与迁移和跨服务读侧一致。
ASSISTANT_POSTGRES_SCHEMA=assistant
# 每个进程的 PostgreSQL 常驻连接池容量。
ASSISTANT_POSTGRES_POOL_SIZE=10
# 连接池满时每个进程可额外建立的 PostgreSQL 连接数。
ASSISTANT_POSTGRES_POOL_OVERFLOW=5
# 建立 PostgreSQL 连接的超时秒数。
ASSISTANT_POSTGRES_CONNECT_TIMEOUT_S=5
# 单条 SQL 在 PostgreSQL 中的超时毫秒数。
ASSISTANT_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 等待数据库锁的超时毫秒数。
ASSISTANT_POSTGRES_LOCK_TIMEOUT_MS=3000

# —— Redis ——
# 所有服务共用的 Redis 实例连接地址。
ASSISTANT_REDIS_HOST=127.0.0.1
# Redis 连接端口，手动运行时填写实际宿主发布端口。
ASSISTANT_REDIS_PORT=6379
# Redis 登录口令；实例无认证时保留注释或填写 null。
# ASSISTANT_REDIS_PASSWORD=null
# Redis 逻辑库编号，参与相同队列、租约或缓存的服务须一致。
ASSISTANT_REDIS_DB=0
# Redis 连接与请求的超时秒数。
ASSISTANT_REDIS_TIMEOUT_S=1

# —— 边缘密钥（与 auth-server 同值）——
# 两枚边缘密钥必填且至少 32 字符；与 auth 对应字段同值。
ASSISTANT_EDGE_SIGNING_SECRET=
# 内部接口服务级密钥，至少 32 字符，须与认证服务一致。
ASSISTANT_EDGE_SERVICE_KEY=

# —— 模型 ——
# 可选环境模型档；启用时必须填写 API_KEY。
ASSISTANT_MODEL_ENABLED=false
# 模型端点；平台模型目录未分配时作为永久默认值。
ASSISTANT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选模型密钥；关闭时用 null，启用环境模型档时必填。
ASSISTANT_MODEL_API_KEY=null
# 对话模型代号；平台模型目录分配优先。
ASSISTANT_MODEL_CHAT=qwen3.8-max
# 未单独配置视觉端点时使用的看图模型代号。
ASSISTANT_MODEL_VISION=qwen3.8-max
# 可选；空值继承对话模型，仅用于折叠历史。
ASSISTANT_SUMMARY_MODEL=
# 上下文 token 预算；多路模型共用时填写最小窗口，不是自动探测值。
ASSISTANT_MODEL_CONTEXT_TOKENS=32768
# 视觉档窗口，0 时沿用对话档。
ASSISTANT_VISION_CONTEXT_TOKENS=0
# 是否流式输出；端点不支持工具流式时可关闭。
ASSISTANT_MODEL_STREAM_ENABLED=true
# 可选 JSON 对象；空值不透传额外请求体。
ASSISTANT_MODEL_EXTRA_BODY=
# 模型调用上限，单位秒；须小于边缘流式请求超时。
ASSISTANT_MODEL_TIMEOUT_S=120
# 连续失败阈值；每个模型档位与用途各自统计。
ASSISTANT_MODEL_BREAKER_FAILURES=5
# 模型断路器重新探测间隔秒数。
ASSISTANT_MODEL_BREAKER_RESET_S=30
# 可选看图端点；空值继承对话端点。
ASSISTANT_VISION_BASE_URL=
# 可选看图密钥；null 继承对话密钥，独立端点时必填。
ASSISTANT_VISION_API_KEY=null
# 可选看图模型；空值继承 MODEL_VISION。
ASSISTANT_VISION_MODEL=
# 视觉调用超时，必须填写正数（秒）
ASSISTANT_VISION_TIMEOUT_S=120
# 可选 JSON 对象；空值继承对话档的额外请求体。
ASSISTANT_VISION_EXTRA_BODY=

# —— 嵌入那一路（可选，默认关）——
# 可选记忆嵌入端点；空值继承对话端点。
ASSISTANT_EMBEDDING_BASE_URL=
# 可选嵌入密钥；null 继承对话密钥，独立端点时必填。
ASSISTANT_EMBEDDING_API_KEY=null
# 可选记忆嵌入模型；空值表示未接，不使用对话模型代号。
ASSISTANT_EMBEDDING_MODEL=
# 记忆向量维数；须与嵌入模型的实际输出一致。
ASSISTANT_EMBEDDING_DIMENSIONS=1536
# 嵌入调用超时，必须填写正数（秒）
ASSISTANT_EMBEDDING_TIMEOUT_S=120

# —— 订阅账号那一路（可选）——
# 订阅推理档位：low/medium/high/xhigh；登录由平台目录管理。
ASSISTANT_CODEX_REASONING_EFFORT=medium

# —— 上游 ——
# 业务平台的内部 HTTP 地址。
ASSISTANT_PLATFORM_BASE_URL=http://127.0.0.1:8005
# 业务平台请求超时秒数。
ASSISTANT_PLATFORM_TIMEOUT_S=5
# 平台模型目录刷新间隔，单位秒；目录分配优先。
ASSISTANT_LLM_CATALOG_REFRESH_S=10
# 模型供应商目录拉取超时秒数。
ASSISTANT_LLM_CATALOG_TIMEOUT_S=3
# 领取平台订阅令牌的预算，单位秒；仅领取，不刷新。
ASSISTANT_LLM_LOGIN_TIMEOUT_S=15
# 认证内部 API 地址，用于长回合委托身份续签。
ASSISTANT_AUTH_BASE_URL=http://127.0.0.1:8004
# 认证服务请求超时秒数。
ASSISTANT_AUTH_TIMEOUT_S=3

# —— 外部 MCP 工具（ADR-0031）——
# 可选 JSON 列表，仅 HTTP(S)；不接时留空，不能写 []。
# ASSISTANT_MCP_SERVERS=
# 可选 JSON 令牌对象；null 未配置，需要鉴权的服务必填。
# ASSISTANT_MCP_TOKENS=null
# 可选 JSON 工具名列表；空值仅允许明确只读工具。
# ASSISTANT_MCP_WRITE_ALLOWED=
# 可选 JSON 对象；写工具需业务权限对、UUID 目标与影响。
# ASSISTANT_MCP_WRITE_POLICIES=
# MCP 单次请求超时秒数。
# ASSISTANT_MCP_TIMEOUT_S=10
# MCP 连续失败阈值，每个外部服务分别统计。
# ASSISTANT_MCP_BREAKER_FAILURES=3
# MCP 断路器重新探测间隔秒数。
# ASSISTANT_MCP_BREAKER_RESET_S=60

# ---- 知识库读侧 ----
# 知识库 API 地址；未部署知识库时留空。
ASSISTANT_KNOWLEDGE_BASE_URL=http://127.0.0.1:8009
# 助手知识库工具请求超时秒数。
ASSISTANT_KNOWLEDGE_TIMEOUT_S=20.0
# 标准技能扩展目录与附加路径映射；留空使用内建技能，变更后重启助手。
# ASSISTANT_SKILLS_DIRECTORY=
# 附加页面路径到技能的映射 JSON 文件，服务进程须可读。
# ASSISTANT_SKILLS_ROUTES_FILE=
