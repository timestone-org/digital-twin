# ai-assistant 本地开发用的环境变量。密钥类留空，**必填**。
# ⚠ 本文件可以提交；填好取值的 .env 不许进版本库。

# —— 进程 ——
ASSISTANT_APP_NAME=ai-assistant
ASSISTANT_APP_ROLE=api
ASSISTANT_APP_INSTANCE=
ASSISTANT_APP_LOG_LEVEL=INFO
ASSISTANT_APP_LOG_FORMAT=text
ASSISTANT_APP_HTTP_HOST=0.0.0.0
ASSISTANT_APP_HTTP_PORT=8006
# 优雅关停时等待在途回合的上限，必须小于编排器的宽限期
ASSISTANT_APP_DRAIN_TIMEOUT_S=20
ASSISTANT_APP_TRACE_SAMPLE_RATIO=0.1

# —— PostgreSQL ——
ASSISTANT_POSTGRES_HOST=127.0.0.1
ASSISTANT_POSTGRES_PORT=5432
ASSISTANT_POSTGRES_USER=
ASSISTANT_POSTGRES_PASSWORD=
ASSISTANT_POSTGRES_DB=
ASSISTANT_POSTGRES_SCHEMA=assistant
ASSISTANT_POSTGRES_POOL_SIZE=10
ASSISTANT_POSTGRES_POOL_OVERFLOW=5
ASSISTANT_POSTGRES_CONNECT_TIMEOUT_S=5
ASSISTANT_POSTGRES_STATEMENT_TIMEOUT_MS=2000
ASSISTANT_POSTGRES_LOCK_TIMEOUT_MS=3000

# —— Redis ——
ASSISTANT_REDIS_HOST=127.0.0.1
ASSISTANT_REDIS_PORT=6379
ASSISTANT_REDIS_PASSWORD=
ASSISTANT_REDIS_DB=0
ASSISTANT_REDIS_TIMEOUT_S=1

# —— 边缘密钥（与 auth-server 同值）——
# ⚠ 两者都必须与 auth-server 那边逐字相同：不同的话表现是一律 401/403，
# 而两边配置单看都对。生成：openssl rand -hex 32
ASSISTANT_EDGE_SIGNING_SECRET=
ASSISTANT_EDGE_SERVICE_KEY=

# —— 模型 ——
# 总开关。关着时服务照常起、会话照常读，只是发不出新回合——这是「现场没有
# 外网」时的正解，不要用改代码或删服务的方式关。
ASSISTANT_MODEL_ENABLED=false
# OpenAI 兼容端点。换供应商只改这一项，代码里不认任何厂商名
ASSISTANT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ⚠ 开关为真时必填，否则**启动即失败**（不是等到第一次对话才报）
ASSISTANT_MODEL_API_KEY=
# 对话模型与视觉模型分两项：视觉的单价与延迟都高得多，混成一项等于每次
# 对话都按视觉计费
ASSISTANT_MODEL_CHAT=qwen3-max
ASSISTANT_MODEL_VISION=qwen-vl-max
# 一次模型调用的上限。⚠ 它比边缘的通用读超时长，所以流式端点不走那条通用配置
ASSISTANT_MODEL_TIMEOUT_S=120
# 断路器：连续失败到这个次数就短路，过了冷却期再放探测请求
ASSISTANT_MODEL_BREAKER_FAILURES=5
ASSISTANT_MODEL_BREAKER_RESET_S=30

# —— 上游 ——
ASSISTANT_PLATFORM_BASE_URL=http://127.0.0.1:8005
ASSISTANT_PLATFORM_TIMEOUT_S=5
