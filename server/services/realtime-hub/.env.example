# realtime-hub 配置模板。生产只用环境变量，本文件是本地开发的便利。
# 标「必填」的项没有默认值，缺失即拒绝启动；其余项写的就是代码里的默认值。
# ⚠ 本文件必须列全部变量：漏一项，下一个部署的人会撞上一个没有文档的启动失败。

# ---- 进程 ----
REALTIME_APP_NAME=realtime-hub
REALTIME_APP_ROLE=hub
# 留空则取主机名，用于在日志里区分副本
REALTIME_APP_INSTANCE=
REALTIME_APP_LOG_LEVEL=INFO
REALTIME_APP_LOG_FORMAT=json
REALTIME_APP_HTTP_HOST=0.0.0.0
REALTIME_APP_HTTP_PORT=8000
# 优雅关停时等待在途连接的上限，必须小于编排器的宽限期
REALTIME_APP_DRAIN_TIMEOUT_S=20.0
REALTIME_APP_TRACE_SAMPLE_RATIO=0.1

# ---- PostgreSQL（必填：host / user / password / db）----
REALTIME_POSTGRES_HOST=
REALTIME_POSTGRES_PORT=5432
REALTIME_POSTGRES_USER=
REALTIME_POSTGRES_PASSWORD=
REALTIME_POSTGRES_DB=
REALTIME_POSTGRES_SCHEMA=realtime
REALTIME_POSTGRES_POOL_SIZE=10
REALTIME_POSTGRES_POOL_OVERFLOW=5
REALTIME_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 热路径语句超时，见 docs/agents/runtime-resilience.md §3.1
REALTIME_POSTGRES_STATEMENT_TIMEOUT_MS=2000
REALTIME_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis（必填：host）----
# 跨副本扇出走它，见 CONTEXT.md §4
REALTIME_REDIS_HOST=
REALTIME_REDIS_PORT=6379
REALTIME_REDIS_PASSWORD=
REALTIME_REDIS_DB=0
REALTIME_REDIS_TIMEOUT_S=1.0

# ---- 边缘（必填：两个密钥）----
# ⚠ 与 auth-server 同值。少写一处就是非对称失效：签得出、验不了，一律 403
REALTIME_EDGE_SIGNING_SECRET=
# /internal/ 的服务级密钥，推送方打内部端点时带它
REALTIME_EDGE_SERVICE_KEY=

# ---- 令牌（必填：REALTIME_JWT_SECRET）----
# ⚠ 与 AUTH_JWT_SECRET 同值，且 issuer 逐字一致：签发方是 auth-server，
# 本服务**只验不签**。分叉的表现是 WS 握手一律被拒，而 HTTP 面完全正常
REALTIME_JWT_SECRET=
# 轮换期的旧密钥。⚠ 留空与不配是同一件事：轮换当中旧令牌会被判成伪造
REALTIME_JWT_PREVIOUS_SECRET=
REALTIME_JWT_ISSUER=auth-server

# ---- 上游 ----
# 登记主题时回调 auth-server 校验声明的权限码是否存在于目录。
# ⚠ 不可达时 fail-closed（拒绝登记），理由见 CONTEXT.md §7
REALTIME_AUTH_BASE_URL=http://auth-server:8004
REALTIME_AUTH_TIMEOUT_S=2.0

# ---- 订阅与扇出 ----
# 权限上下文的复核间隔。到点重取调用者的权限码，不再满足的主题就地退订——
# ⚠ 不断整条连接，那会牵连用户正在看的其它无关主题
REALTIME_PERMISSION_TTL_S=60
# 单条推送的条目上限，超出即拒绝，让推送方去分片。
# ⚠ 推送方的 PUBLISH_MAX_ITEMS 必须 ≤ 它，否则每一批都被 413
REALTIME_MAX_PAYLOAD_ITEMS=500
# 跨副本扇出的频道名。走一条频道，主题写在消息里由各副本自己筛
REALTIME_FANOUT_CHANNEL=realtime.fanout

# ---- 匿名连接（公开大屏，见 docs/adr/0021）----
# 一条匿名连接最长活多久。到点由复核任务关掉，客户端拿同一枚票据重连，
# 于是授权被重新验一次
REALTIME_PUBLIC_GRANT_TTL_S=3600
# 匿名连接的授权复核周期（秒）。撤回一条公开链接之后，已经连着的那些最多
# 这么久被断掉
REALTIME_PUBLIC_RECHECK_INTERVAL_S=15.0
# ⚠ 名额按**副本**计：它防的是一枚泄露的公开令牌把单个副本的连接池吃满
REALTIME_PUBLIC_MAX_CONNECTIONS=500
REALTIME_PUBLIC_MAX_CONNECTIONS_PER_TICKET=50
