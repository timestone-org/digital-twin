# realtime-hub 手动部署模板，复制为服务目录下的 .env（UTF-8 无 BOM）。
# 请填写必填连接与密钥；可选项按需取消注释，进程环境覆盖同名配置。

# ---- 进程 ----
# 服务名，用于日志、指标和诊断。
REALTIME_APP_NAME=realtime-hub
# 实时通道进程角色，使用 hub。
REALTIME_APP_ROLE=hub
# 实例名，与NSSM服务名一致
REALTIME_APP_INSTANCE=dt-realtime
# 日志级别，可设 DEBUG、INFO、WARNING、ERROR 或 CRITICAL。
REALTIME_APP_LOG_LEVEL=INFO
# 日志输出格式，部署默认使用 json。
REALTIME_APP_LOG_FORMAT=json
# HTTP 监听地址；同机网关可使用回环地址。
REALTIME_APP_HTTP_HOST=127.0.0.1
# HTTP 监听端口；须与网关或调用方所配的端口一致。
REALTIME_APP_HTTP_PORT=8000
# 关停等待秒数，须小于NSSM等待
REALTIME_APP_DRAIN_TIMEOUT_S=20.0
# HTTP 摘除就绪后继续监听的秒数。
REALTIME_APP_READINESS_WITHDRAW_S=2.0

# ---- PostgreSQL（密码必填） ----
# 共享 PostgreSQL 实例的连接地址。
REALTIME_POSTGRES_HOST=127.0.0.1
# PostgreSQL 连接端口，手动运行时填写实际宿主发布端口。
REALTIME_POSTGRES_PORT=5432
# 服务用于访问本属 schema 的 PostgreSQL 登录账号。
REALTIME_POSTGRES_USER=postgres
# PostgreSQL 登录口令，必填。
REALTIME_POSTGRES_PASSWORD=
# 项目共享的 PostgreSQL 数据库名，须与其他服务一致。
REALTIME_POSTGRES_DB=dt_db
# 本服务持有的数据库 schema，须与迁移和跨服务读侧一致。
REALTIME_POSTGRES_SCHEMA=realtime
# 每个进程的 PostgreSQL 常驻连接池容量。
REALTIME_POSTGRES_POOL_SIZE=10
# 连接池满时每个进程可额外建立的 PostgreSQL 连接数。
REALTIME_POSTGRES_POOL_OVERFLOW=5
# 建立 PostgreSQL 连接的超时秒数。
REALTIME_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 数据库语句超时，毫秒
REALTIME_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 等待数据库锁的超时毫秒数。
REALTIME_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis ----
# Redis地址，各服务使用同一实例
REALTIME_REDIS_HOST=127.0.0.1
# Redis 连接端口，手动运行时填写实际宿主发布端口。
REALTIME_REDIS_PORT=6379
# Redis 登录口令；实例无认证时保留注释或填写 null。
# REALTIME_REDIS_PASSWORD=null
# Redis 逻辑库编号，参与相同队列、租约或缓存的服务须一致。
REALTIME_REDIS_DB=0
# Redis 连接与请求的超时秒数。
REALTIME_REDIS_TIMEOUT_S=1.0

# ---- 边缘（密钥必填） ----
# 必填≥32字符，各消费服务同值
REALTIME_EDGE_SIGNING_SECRET=
# 必填≥32字符，所有服务及nginx同值
REALTIME_EDGE_SERVICE_KEY=

# ---- JWT（主密钥必填） ----
# 必填≥32字符，认证与实时同值
REALTIME_JWT_SECRET=
# 认证与实时同值，无旧密钥用null
# REALTIME_JWT_PREVIOUS_SECRET=null
# JWT 签发者名称，须与 auth-server 的 AUTH_JWT_ISSUER 一致。
REALTIME_JWT_ISSUER=auth-server

# ---- 上游 ----
# 认证服务地址，校验权限码及用户权限
REALTIME_AUTH_BASE_URL=http://127.0.0.1:8004
# 认证服务请求超时秒数。
REALTIME_AUTH_TIMEOUT_S=2.0

# ---- 订阅与扇出 ----
# 单帧最大条目数，推送方须不超过
REALTIME_MAX_PAYLOAD_ITEMS=500
# 跨副本扇出的Redis频道
REALTIME_FANOUT_CHANNEL=realtime.fanout

# ---- 匿名连接 ----
# 匿名连接有效期秒数，至少60
REALTIME_PUBLIC_GRANT_TTL_S=3600
# 匿名授权复核间隔，秒
REALTIME_PUBLIC_RECHECK_INTERVAL_S=15.0
# 每副本匿名连接总数上限
REALTIME_PUBLIC_MAX_CONNECTIONS=500
# 同一公开票据的匿名 WebSocket 连接上限。
REALTIME_PUBLIC_MAX_CONNECTIONS_PER_TICKET=50
