# auth-server 手动部署模板，复制为服务目录下的 .env（UTF-8 无 BOM）。
# 请填写必填连接与密钥；可选项按需取消注释，进程环境覆盖同名配置。

# ---- 进程 ----
# 服务名，用于日志、指标和诊断。
AUTH_APP_NAME=auth-server
# 认证服务的 HTTP API 运行角色，使用 api。
AUTH_APP_ROLE=api
# 实例名，与NSSM服务名一致
AUTH_APP_INSTANCE=dt-auth
# 日志级别，可设 DEBUG、INFO、WARNING、ERROR 或 CRITICAL。
AUTH_APP_LOG_LEVEL=INFO
# 日志输出格式，部署默认使用 json。
AUTH_APP_LOG_FORMAT=json
# HTTP 监听地址；同机网关可使用回环地址。
AUTH_APP_HTTP_HOST=127.0.0.1
# HTTP 监听端口；须与网关或调用方所配的端口一致。
AUTH_APP_HTTP_PORT=8004
# 关停等待秒数，须小于NSSM等待
AUTH_APP_DRAIN_TIMEOUT_S=20.0
# HTTP 摘除就绪后继续监听的秒数。
AUTH_APP_READINESS_WITHDRAW_S=2.0

# ---- PostgreSQL（密码必填） ----
# 共享 PostgreSQL 实例的连接地址。
AUTH_POSTGRES_HOST=127.0.0.1
# PostgreSQL 连接端口，手动运行时填写实际宿主发布端口。
AUTH_POSTGRES_PORT=5432
# 服务用于访问本属 schema 的 PostgreSQL 登录账号。
AUTH_POSTGRES_USER=postgres
# PostgreSQL 登录口令，必填。
AUTH_POSTGRES_PASSWORD=
# 项目共享的 PostgreSQL 数据库名，须与其他服务一致。
AUTH_POSTGRES_DB=dt_db
# 本服务持有的数据库 schema，须与迁移和跨服务读侧一致。
AUTH_POSTGRES_SCHEMA=auth
# 每个进程的 PostgreSQL 常驻连接池容量。
AUTH_POSTGRES_POOL_SIZE=10
# 连接池满时每个进程可额外建立的 PostgreSQL 连接数。
AUTH_POSTGRES_POOL_OVERFLOW=5
# 建立 PostgreSQL 连接的超时秒数。
AUTH_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 数据库语句超时，毫秒
AUTH_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 等待数据库锁的超时毫秒数。
AUTH_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis ----
# 所有服务共用的 Redis 实例连接地址。
AUTH_REDIS_HOST=127.0.0.1
# Redis 连接端口，手动运行时填写实际宿主发布端口。
AUTH_REDIS_PORT=6379
# Redis 登录口令；实例无认证时保留注释或填写 null。
# AUTH_REDIS_PASSWORD=null
# Redis 逻辑库编号，参与相同队列、租约或缓存的服务须一致。
AUTH_REDIS_DB=0
# Redis 连接与请求的超时秒数。
AUTH_REDIS_TIMEOUT_S=1.0

# ---- JWT（主密钥必填） ----
# 必填≥32字符，认证与实时同值
AUTH_JWT_SECRET=
# 认证与实时同值，无旧密钥用null
# AUTH_JWT_PREVIOUS_SECRET=null
# JWT 签发者名称。
AUTH_JWT_ISSUER=auth-server
# 登录 access token 有效期秒数，保持 900。
AUTH_JWT_ACCESS_TTL_S=900
# 登录 refresh token 有效期秒数。
AUTH_JWT_REFRESH_TTL_S=1209600

# ---- 边缘（密钥必填） ----
# 必填≥32字符，各消费服务同值
AUTH_EDGE_SIGNING_SECRET=
# 必填≥32字符，所有服务及nginx同值
AUTH_EDGE_SERVICE_KEY=
# 边缘权限缓存有效期秒数。
AUTH_EDGE_PERMISSION_TTL_S=60

# ---- API密钥 ----
# API密钥散列校验缓存秒数，至少1
AUTH_API_KEY_VERIFY_CACHE_TTL_S=60
# API密钥使用时间写库间隔秒数，至少1
AUTH_API_KEY_TOUCH_INTERVAL_S=60

# ---- argon2 并发 ----
# 口令通道并发上限，至少1，每路约占64MiB
AUTH_ARGON2_PASSWORD_MAX_CONCURRENCY=2
# API密钥通道并发上限，至少1，每路约占64MiB
AUTH_ARGON2_API_KEY_MAX_CONCURRENCY=2

# ---- 限流与注册 ----
# 登录限流窗口内的尝试次数上限。
AUTH_LOGIN_MAX_ATTEMPTS=10
# 登录限流窗口秒数。
AUTH_LOGIN_WINDOW_S=300
# 是否开放账号注册。
# AUTH_SIGNUP_ENABLED=false
# 注册限流窗口内的尝试次数上限。
# AUTH_SIGNUP_MAX_ATTEMPTS=5
# 注册限流窗口秒数。
# AUTH_SIGNUP_WINDOW_S=3600
# 注册账号的初始角色名称。
# AUTH_SIGNUP_DEFAULT_ROLE=viewer

# ---- 管理员初始化 ----
# 首次初始化管理员用户名；已有账号保留原配置。
AUTH_SEED_ADMIN_USERNAME=admin
# 首次初始化管理员邮箱；已有账号保留原配置。
AUTH_SEED_ADMIN_EMAIL=admin@example.com
# 种子必填，10至128字符且含字母数字
AUTH_SEED_ADMIN_PASSWORD=
