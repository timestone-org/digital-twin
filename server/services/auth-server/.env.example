# auth-server Windows NSSM 配置。
# 部署手册：docs/DEPLOY_WINDOWS_NSSM.md

# ---- 进程 ----
AUTH_APP_NAME=auth-server
AUTH_APP_ROLE=api
# 实例名，与NSSM服务名一致
AUTH_APP_INSTANCE=dt-auth
AUTH_APP_LOG_LEVEL=INFO
AUTH_APP_LOG_FORMAT=json
AUTH_APP_HTTP_HOST=127.0.0.1
AUTH_APP_HTTP_PORT=8004
# 关停等待秒数，须小于NSSM等待
AUTH_APP_DRAIN_TIMEOUT_S=20.0
AUTH_APP_TRACE_SAMPLE_RATIO=0.1

# ---- PostgreSQL（密码必填） ----
AUTH_POSTGRES_HOST=127.0.0.1
AUTH_POSTGRES_PORT=5432
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=
AUTH_POSTGRES_DB=dt_db
AUTH_POSTGRES_SCHEMA=auth
AUTH_POSTGRES_POOL_SIZE=10
AUTH_POSTGRES_POOL_OVERFLOW=5
AUTH_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 数据库语句超时，毫秒
AUTH_POSTGRES_STATEMENT_TIMEOUT_MS=2000
AUTH_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis ----
AUTH_REDIS_HOST=127.0.0.1
AUTH_REDIS_PORT=6379
# 有密码必填，无密码用null
AUTH_REDIS_PASSWORD=null
AUTH_REDIS_DB=0
AUTH_REDIS_TIMEOUT_S=1.0

# ---- JWT（主密钥必填） ----
# 必填≥32字符，认证与实时同值
AUTH_JWT_SECRET=
# 认证与实时同值，无旧密钥用null
AUTH_JWT_PREVIOUS_SECRET=null
AUTH_JWT_ISSUER=auth-server
AUTH_JWT_ACCESS_TTL_S=900
AUTH_JWT_REFRESH_TTL_S=1209600

# ---- 边缘（密钥必填） ----
# 必填≥32字符，各消费服务同值
AUTH_EDGE_SIGNING_SECRET=
# 必填≥32字符，所有服务及nginx同值
AUTH_EDGE_SERVICE_KEY=
AUTH_EDGE_PERMISSION_TTL_S=60

# ---- API密钥 ----
# API密钥散列校验缓存秒数，至少1
AUTH_API_KEY_VERIFY_CACHE_TTL_S=60
# API密钥使用时间写库间隔秒数，至少1
AUTH_API_KEY_TOUCH_INTERVAL_S=60

# ---- 限流与注册 ----
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_S=300
AUTH_SIGNUP_ENABLED=false
AUTH_SIGNUP_MAX_ATTEMPTS=5
AUTH_SIGNUP_WINDOW_S=3600
AUTH_SIGNUP_DEFAULT_ROLE=viewer

# ---- 管理员初始化 ----
AUTH_SEED_ADMIN_USERNAME=admin
AUTH_SEED_ADMIN_EMAIL=admin@example.com
# 种子必填，10至128字符且含字母数字
AUTH_SEED_ADMIN_PASSWORD=
