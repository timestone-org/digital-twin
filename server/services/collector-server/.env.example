# collector-server 配置模板。生产只用环境变量，本文件是本地开发的便利。
# 标「必填」的项没有默认值，缺失即拒绝启动；其余项写的就是代码里的默认值。
# ⚠ 本文件必须列全部变量：漏一项，下一个部署的人会撞上一个没有文档的启动失败。

# ---- 进程 ----
COLLECT_APP_NAME=collector-server
COLLECT_APP_ROLE=collector
# 留空则取主机名，用于在日志与运行态表里区分副本
COLLECT_APP_INSTANCE=
COLLECT_APP_LOG_LEVEL=INFO
COLLECT_APP_LOG_FORMAT=json
COLLECT_APP_HTTP_HOST=0.0.0.0
# 只服务 /health 与 /ready，没有业务面
COLLECT_APP_HTTP_PORT=8007
# 优雅关停的上限，必须小于编排器的宽限期
COLLECT_APP_DRAIN_TIMEOUT_S=20.0
COLLECT_APP_TRACE_SAMPLE_RATIO=0.1

# ---- PostgreSQL（必填：host / user / password / db）----
COLLECT_POSTGRES_HOST=
COLLECT_POSTGRES_PORT=5432
COLLECT_POSTGRES_USER=
COLLECT_POSTGRES_PASSWORD=
COLLECT_POSTGRES_DB=
COLLECT_POSTGRES_SCHEMA=collect
COLLECT_POSTGRES_POOL_SIZE=10
COLLECT_POSTGRES_POOL_OVERFLOW=5
COLLECT_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 热路径语句超时，见 docs/agents/runtime-resilience.md §3.1
COLLECT_POSTGRES_STATEMENT_TIMEOUT_MS=2000
COLLECT_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis（必填 host）----
# 选主租约、快照哈希、命令总线三条面都打它
COLLECT_REDIS_HOST=
COLLECT_REDIS_PORT=6379
COLLECT_REDIS_PASSWORD=
COLLECT_REDIS_DB=0
COLLECT_REDIS_TIMEOUT_S=1.0

# ---- 采集计划（必填密钥）----
# ⚠ 与 auth-server 的 AUTH_EDGE_SERVICE_KEY 同值：分叉就是永远拉不到计划、
# 采集永久空转，而现象与原因隔得极远
COLLECT_EDGE_SERVICE_KEY=
COLLECT_PLATFORM_BASE_URL=http://platform-server:8005
COLLECT_PLAN_TIMEOUT_S=5.0
COLLECT_PLAN_REFRESH_INTERVAL_S=30.0

# ---- 快照 ----
# 窗口内同一点位后值覆盖前值（快照是采样，不是事件流）
COLLECT_FLUSH_INTERVAL_MS=300
# ⚠ 每次 flush 续期。采集进程死掉后快照跟着过期，大屏于是拿不到值，
# 而不是拿着一份永不更新的旧值当实时值看
COLLECT_SNAPSHOT_TTL_S=60

# ---- 归档 ----
# Stream 落 TimescaleDB 的周期（缓冲落 Stream 用上面的 FLUSH_INTERVAL_MS）
COLLECT_ARCHIVE_FLUSH_MS=5000
# ⚠ 归档缓冲的显式上限。落库一卡就无限涨是参考实现最难查的问题，
# 超限丢最旧并计数上报
COLLECT_ARCHIVE_BUFFER_MAX=200000
# 一条 Stream 条目与一条 INSERT 各自最多带多少行。写库时再按 asyncpg 的
# 32767 个绑定参数上限收一次（六列 → 5461 行）
COLLECT_ARCHIVE_BATCH_ROWS=1000
# ⚠ Stream 的条目上限，writer 长期落后时的最后一道背压。裁掉的是最旧的
# 条目，所以追不上就是在丢历史——顶到上限会响亮告警
COLLECT_ARCHIVE_STREAM_MAXLEN=10000

# ---- 命令总线 ----
COLLECT_COMMAND_BLOCK_S=1.0
COLLECT_COMMAND_REPLY_TTL_S=60

# ---- 会话 ----
COLLECT_HEARTBEAT_INTERVAL_S=10.0
COLLECT_RECONNECT_MAX_BACKOFF_S=60.0
