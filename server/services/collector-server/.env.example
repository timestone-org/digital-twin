# collector-server Windows NSSM 配置模板；密码与必填密钥须填写。
# 部署手册：docs/DEPLOY_WINDOWS_NSSM.md

# ---- 进程 ----
COLLECT_APP_NAME=collector-server
COLLECT_APP_ROLE=collector
# 副本实例名；同机热备还须覆盖 HTTP_PORT，避免端口冲突。
COLLECT_APP_INSTANCE=dt-collector
COLLECT_APP_LOG_LEVEL=INFO
COLLECT_APP_LOG_FORMAT=json
COLLECT_APP_HTTP_HOST=127.0.0.1
# 只监听 health/ready 探针，没有业务 HTTP 面。
COLLECT_APP_HTTP_PORT=8007
# 优雅关停预算（秒）；须小于 NSSM 停止等待时间。
COLLECT_APP_DRAIN_TIMEOUT_S=20.0
COLLECT_APP_TRACE_SAMPLE_RATIO=0.1

# ---- PostgreSQL（密码必填）----
# 各服务共用 database；历史归档要求 TimescaleDB 扩展。
COLLECT_POSTGRES_HOST=127.0.0.1
COLLECT_POSTGRES_PORT=5432
COLLECT_POSTGRES_USER=postgres
COLLECT_POSTGRES_PASSWORD=
COLLECT_POSTGRES_DB=dt_db
COLLECT_POSTGRES_SCHEMA=collect
COLLECT_POSTGRES_POOL_SIZE=10
COLLECT_POSTGRES_POOL_OVERFLOW=5
COLLECT_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 热路径 SQL 超时（毫秒）。
COLLECT_POSTGRES_STATEMENT_TIMEOUT_MS=2000
COLLECT_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis（跨服务共用实例和 DB）----
# 与 platform 共用实例和 DB；租约、快照、命令与归档均使用它。
COLLECT_REDIS_HOST=127.0.0.1
COLLECT_REDIS_PORT=6379
# 无密码用 null；有密码填实际值，勿留空字符串。
COLLECT_REDIS_PASSWORD=null
COLLECT_REDIS_DB=0
COLLECT_REDIS_TIMEOUT_S=1.0

# ---- 采集计划（必填密钥）----
# 必填，至少32字符；与 PLATFORM_EDGE_SERVICE_KEY 等全栈同值。
COLLECT_EDGE_SERVICE_KEY=
COLLECT_PLATFORM_BASE_URL=http://127.0.0.1:8005
COLLECT_PLAN_TIMEOUT_S=5.0
COLLECT_PLAN_REFRESH_INTERVAL_S=30.0

# ---- 快照 ----
# 快照与归档缓冲刷出间隔（毫秒）；同一点位后值覆盖前值。
COLLECT_FLUSH_INTERVAL_MS=300
# 快照存活时间（秒）；每次刷出续期，进程停止后自动过期。
COLLECT_SNAPSHOT_TTL_S=60

# ---- 归档 ----
# 归档运行参数默认值；关闭后停止记录历史。
COLLECT_ARCHIVE_ENABLED=true
# Stream 落库间隔（毫秒）；缓冲刷出使用 FLUSH_INTERVAL_MS。
COLLECT_ARCHIVE_FLUSH_MS=5000
# 归档缓冲行数上限；超限丢弃最旧行并记录告警。
COLLECT_ARCHIVE_BUFFER_MAX=200000
# 单条 Stream 与 INSERT 最大行数；数据库会再收紧上限。
COLLECT_ARCHIVE_BATCH_ROWS=1000
# 归档流条目上限；触顶裁剪最旧条目会丢历史并告警。
COLLECT_ARCHIVE_STREAM_MAXLEN=10000

# ---- 命令总线 ----
COLLECT_COMMAND_BLOCK_S=1.0
COLLECT_COMMAND_REPLY_TTL_S=60

# ---- 会话 ----
# 心跳周期（秒）；Windows 宿主机须具备通往工控网的路由。
COLLECT_HEARTBEAT_INTERVAL_S=10.0
COLLECT_RECONNECT_MAX_BACKOFF_S=60.0
COLLECT_PLC_MAX_CONCURRENT_REQUESTS=8
COLLECT_PLC_READ_ENABLED=false
# 精确 PLC IP:端口清单，逗号分隔；现场授权后再开启读取。
COLLECT_PLC_ALLOWED_ENDPOINTS=

# ---- HTTP 采集 ----
COLLECT_HTTP_READ_ENABLED=false
# 数据与 OAuth2 端点的精确 HTTP(S) origin，逗号分隔；启用前必填。
COLLECT_HTTP_ALLOWED_ENDPOINTS=
COLLECT_HTTP_MAX_CONCURRENT_REQUESTS=8
