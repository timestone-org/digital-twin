# opcua-server 手动部署模板，复制为服务目录下的 .env（UTF-8 无 BOM）。
# 请填写必填连接与密钥；可选项按需取消注释，进程环境覆盖同名配置。

# ---- 进程 ----
# 服务名，用于日志、指标和诊断。
OPCUA_APP_NAME=opcua-server
# OPC UA 的 HTTP 管理运行角色，使用 api；进程单活。
OPCUA_APP_ROLE=api
# 实例名对应NSSM服务名，进程必须单活
OPCUA_APP_INSTANCE=dt-opcua
# 日志级别，可设 DEBUG、INFO、WARNING、ERROR 或 CRITICAL。
OPCUA_APP_LOG_LEVEL=INFO
# 日志输出格式，部署默认使用 json。
OPCUA_APP_LOG_FORMAT=json
# HTTP 监听地址；同机网关可使用回环地址。
OPCUA_APP_HTTP_HOST=127.0.0.1
# 仅HTTP管理端口，opc.tcp走端口池
OPCUA_APP_HTTP_PORT=8008
# 关停等待秒数，须小于NSSM等待
OPCUA_APP_DRAIN_TIMEOUT_S=20.0
# HTTP 摘除就绪后继续监听的秒数。
OPCUA_APP_READINESS_WITHDRAW_S=2.0

# ---- PostgreSQL（密码必填） ----
# 共享 PostgreSQL 实例的连接地址。
OPCUA_POSTGRES_HOST=127.0.0.1
# PostgreSQL 连接端口，手动运行时填写实际宿主发布端口。
OPCUA_POSTGRES_PORT=5432
# 服务用于访问本属 schema 的 PostgreSQL 登录账号。
OPCUA_POSTGRES_USER=postgres
# PostgreSQL 登录口令，必填。
OPCUA_POSTGRES_PASSWORD=
# 项目共享的 PostgreSQL 数据库名，须与其他服务一致。
OPCUA_POSTGRES_DB=dt_db
# 本服务持有的数据库 schema，须与迁移和跨服务读侧一致。
OPCUA_POSTGRES_SCHEMA=opcua
# 每个进程的 PostgreSQL 常驻连接池容量。
OPCUA_POSTGRES_POOL_SIZE=10
# 连接池满时每个进程可额外建立的 PostgreSQL 连接数。
OPCUA_POSTGRES_POOL_OVERFLOW=5
# 建立 PostgreSQL 连接的超时秒数。
OPCUA_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 数据库语句超时，毫秒
OPCUA_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 等待数据库锁的超时毫秒数。
OPCUA_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis ----
# 所有服务共用的 Redis 实例连接地址。
OPCUA_REDIS_HOST=127.0.0.1
# Redis 连接端口，手动运行时填写实际宿主发布端口。
OPCUA_REDIS_PORT=6379
# Redis 登录口令；实例无认证时保留注释或填写 null。
# OPCUA_REDIS_PASSWORD=null
# Redis 逻辑库编号，参与相同队列、租约或缓存的服务须一致。
OPCUA_REDIS_DB=0
# Redis 连接与请求的超时秒数。
OPCUA_REDIS_TIMEOUT_S=1.0

# ---- 边缘（密钥必填） ----
# 必填≥32字符，各消费服务同值
OPCUA_EDGE_SIGNING_SECRET=
# 必填≥32字符，所有服务及nginx同值
OPCUA_EDGE_SERVICE_KEY=

# ---- 实例托管 ----
# opc.tcp 端口段，端口数量须覆盖 OPCUA_MAX_INSTANCES，客户端网络须可达。
OPCUA_PORT_POOL=4840-4859
# 上位机可访问的 DNS 名或 IP，留空沿用主机名。
# OPCUA_ADVERTISED_HOST=opcua.example.test
# 同时托管实例上限，不超过端口池容量
OPCUA_MAX_INSTANCES=16
# 证书私钥目录，须可写并单独备份
OPCUA_PKI_DIR=C:/DigitalTwin/data/opcua-pki
# 自签证书有效天数
OPCUA_CERT_VALID_DAYS=825

# ---- 实时通道 ----
# 实时服务地址，登记主题及推送值
OPCUA_REALTIME_BASE_URL=http://127.0.0.1:8000
# 实时通道请求超时秒数。
OPCUA_REALTIME_TIMEOUT_S=2.0
# 值变化合并窗口毫秒数，至少200
OPCUA_PUBLISH_WINDOW_MS=1000
# 单帧节点上限，不超过实时条目上限
OPCUA_PUBLISH_MAX_NODES=500
