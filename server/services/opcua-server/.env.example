# opcua-server 配置模板。生产只用环境变量，本文件是本地开发的便利。
# 标「必填」的项没有默认值，缺失即拒绝启动；其余项写的就是代码里的默认值。
# ⚠ 本文件必须列全部变量：漏一项，下一个部署的人会撞上一个没有文档的启动失败。

# ---- 进程 ----
OPCUA_APP_NAME=opcua-server
OPCUA_APP_ROLE=api
# 留空则取主机名，用于在日志里区分副本
OPCUA_APP_INSTANCE=
OPCUA_APP_LOG_LEVEL=INFO
OPCUA_APP_LOG_FORMAT=json
OPCUA_APP_HTTP_HOST=0.0.0.0
# 只有 HTTP 管理面在这个端口。实例的 opc.tcp 端口来自下面的端口池
OPCUA_APP_HTTP_PORT=8008
# 优雅关停时等待在途请求的上限，必须小于编排器的宽限期
OPCUA_APP_DRAIN_TIMEOUT_S=20.0
OPCUA_APP_TRACE_SAMPLE_RATIO=0.1

# ---- PostgreSQL（必填：host / user / password / db）----
OPCUA_POSTGRES_HOST=
OPCUA_POSTGRES_PORT=5432
OPCUA_POSTGRES_USER=
OPCUA_POSTGRES_PASSWORD=
OPCUA_POSTGRES_DB=
OPCUA_POSTGRES_SCHEMA=opcua
OPCUA_POSTGRES_POOL_SIZE=10
OPCUA_POSTGRES_POOL_OVERFLOW=5
OPCUA_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 热路径语句超时，见 docs/agents/runtime-resilience.md §3.1
OPCUA_POSTGRES_STATEMENT_TIMEOUT_MS=2000
OPCUA_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis（必填：host）----
OPCUA_REDIS_HOST=
OPCUA_REDIS_PORT=6379
OPCUA_REDIS_PASSWORD=
OPCUA_REDIS_DB=0
OPCUA_REDIS_TIMEOUT_S=1.0

# ---- 边缘（必填：两个密钥）----
# ⚠ 与 auth-server 同值。少写一处就是非对称失效——边缘签得出、这边验不了，
# 表现为本服务一律 403，而现象与原因隔得极远
OPCUA_EDGE_SIGNING_SECRET=
# /internal/ 的服务级密钥，逐字比较。未配置一律拒绝，不是放行
OPCUA_EDGE_SERVICE_KEY=

# ---- 实例托管 ----
# opc.tcp 端口池，形如 `<起>-<止>`。⚠ 必须与编排层真正映射/放行的端口段逐字
# 一致：池外的端口连不进来，而实例状态仍显示「运行中」——最难排查的一类故障
OPCUA_PORT_POOL=4840-4859
# 单进程内同时运行的实例数上限，必须 ≤ 端口池容量（启动时校验）
OPCUA_MAX_INSTANCES=16
# 服务器证书与私钥的落盘位置。⚠ 私钥只在这里——不进镜像层、不进数据库，
# 因此**不随数据库备份走**；目录丢了等于全部实例的证书作废
OPCUA_PKI_DIR=/var/lib/opcua/pki
# 自签证书的有效期（天）
OPCUA_CERT_VALID_DAYS=825

# ---- 实时通道 ----
# 实例生灭时登记/注销主题、值变化批推都打它。
# ⚠ 不可达时**不阻断建实例**：降级方向是「少一个实时通道」
OPCUA_REALTIME_BASE_URL=http://realtime-hub:8000
OPCUA_REALTIME_TIMEOUT_S=2.0
# 值变化推送的合并窗口：上位机可以每秒写几十次，逐次推送会打爆通道
OPCUA_PUBLISH_WINDOW_MS=1000
# 单条推送消息里最多带几个节点，超出即分片
OPCUA_PUBLISH_MAX_NODES=500
