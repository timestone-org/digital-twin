# 层级图服务配置，密钥和连接项由部署环境注入。
# 层级图 redis host。
# HIERARCHY_REDIS_HOST=
# 层级图 redis port。
# HIERARCHY_REDIS_PORT=6379
# 层级图 redis password。
# HIERARCHY_REDIS_PASSWORD=null
# 层级图 redis db。
# HIERARCHY_REDIS_DB=0
# 层级图 redis timeout s。
# HIERARCHY_REDIS_TIMEOUT_S=1.0
# 层级图 postgres host。
# HIERARCHY_POSTGRES_HOST=
# 层级图 postgres port。
# HIERARCHY_POSTGRES_PORT=5432
# 层级图 postgres user。
# HIERARCHY_POSTGRES_USER=
# 层级图 postgres password。
# HIERARCHY_POSTGRES_PASSWORD=
# 层级图 postgres db。
# HIERARCHY_POSTGRES_DB=
# 层级图 postgres schema。
# HIERARCHY_POSTGRES_SCHEMA=hierarchy
# 层级图 postgres pool size。
# HIERARCHY_POSTGRES_POOL_SIZE=10
# 层级图 postgres pool overflow。
# HIERARCHY_POSTGRES_POOL_OVERFLOW=5
# 层级图 postgres connect timeout s。
# HIERARCHY_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 层级图 postgres statement timeout ms。
# HIERARCHY_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# 层级图 postgres lock timeout ms。
# HIERARCHY_POSTGRES_LOCK_TIMEOUT_MS=3000
# 层级图 app name。
# HIERARCHY_APP_NAME=hierarchy-server
# 层级图 app role。
# HIERARCHY_APP_ROLE=api
# 层级图 app instance。
# HIERARCHY_APP_INSTANCE=
# 层级图 app log level。
# HIERARCHY_APP_LOG_LEVEL=INFO
# 层级图 app log format。
# HIERARCHY_APP_LOG_FORMAT=json
# 层级图 app http host。
# HIERARCHY_APP_HTTP_HOST=0.0.0.0
# 层级图 app http port。
# HIERARCHY_APP_HTTP_PORT=8010
# 层级图 app drain timeout s。
# HIERARCHY_APP_DRAIN_TIMEOUT_S=20.0
# 层级图 app trace sample ratio。
# HIERARCHY_APP_TRACE_SAMPLE_RATIO=0.1
# 层级图 edge signing secret。
# HIERARCHY_EDGE_SIGNING_SECRET=
# 层级图 edge service key。
# HIERARCHY_EDGE_SERVICE_KEY=
