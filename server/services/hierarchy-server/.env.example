# hierarchy-server 手动部署模板，复制为服务目录下的 .env（UTF-8 无 BOM）。
# 请填写必填连接与密钥；可选项按需取消注释，进程环境覆盖同名配置。
# 部署手册：docs/DEPLOY_WINDOWS_NSSM.md

# 所有服务共用的 Redis 实例连接地址。
HIERARCHY_REDIS_HOST=127.0.0.1
# Redis 连接端口，手动运行时填写实际宿主发布端口。
# HIERARCHY_REDIS_PORT=6379
# Redis 登录口令；实例无认证时保留注释或填写 null。
# HIERARCHY_REDIS_PASSWORD=null
# Redis 逻辑库编号，参与相同队列、租约或缓存的服务须一致。
# HIERARCHY_REDIS_DB=0
# Redis 连接与请求的超时秒数。
# HIERARCHY_REDIS_TIMEOUT_S=1.0
# 共享 PostgreSQL 实例的连接地址。
HIERARCHY_POSTGRES_HOST=127.0.0.1
# PostgreSQL 连接端口，手动运行时填写实际宿主发布端口。
# HIERARCHY_POSTGRES_PORT=5432
# 服务用于访问本属 schema 的 PostgreSQL 登录账号。
HIERARCHY_POSTGRES_USER=postgres
# PostgreSQL 登录口令，必填。
HIERARCHY_POSTGRES_PASSWORD=
# 项目共享的 PostgreSQL 数据库名，须与其他服务一致。
HIERARCHY_POSTGRES_DB=dt_db
# 本服务持有的数据库 schema，须与迁移和跨服务读侧一致。
# HIERARCHY_POSTGRES_SCHEMA=hierarchy
# 每个进程的 PostgreSQL 常驻连接池容量。
# HIERARCHY_POSTGRES_POOL_SIZE=10
# 连接池满时每个进程可额外建立的 PostgreSQL 连接数。
# HIERARCHY_POSTGRES_POOL_OVERFLOW=5
# 建立 PostgreSQL 连接的超时秒数。
# HIERARCHY_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 单条 SQL 在 PostgreSQL 中的超时毫秒数。
# HIERARCHY_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# PostgreSQL 等待数据库锁的超时毫秒数。
# HIERARCHY_POSTGRES_LOCK_TIMEOUT_MS=3000
# 服务名，用于日志、指标和诊断。
# HIERARCHY_APP_NAME=hierarchy-server
# 层级图的 HTTP API 运行角色，使用 api。
# HIERARCHY_APP_ROLE=api
# 进程实例名，用于日志和诊断；同一部署中各进程应取不同值。
HIERARCHY_APP_INSTANCE=dt-hierarchy
# 日志级别，可设 DEBUG、INFO、WARNING、ERROR 或 CRITICAL。
# HIERARCHY_APP_LOG_LEVEL=INFO
# 日志输出格式，部署默认使用 json。
# HIERARCHY_APP_LOG_FORMAT=json
# HTTP 监听地址；同机网关可使用回环地址。
HIERARCHY_APP_HTTP_HOST=127.0.0.1
# HTTP 监听端口；须与网关或调用方所配的端口一致。
# HIERARCHY_APP_HTTP_PORT=8010
# 退出前排空在途工作的最大秒数，须留在进程管理器的关停宽限内。
# HIERARCHY_APP_DRAIN_TIMEOUT_S=20.0
# 撤销就绪后继续监听的秒数，让上游停止发送新请求。
# HIERARCHY_APP_READINESS_WITHDRAW_S=2.0
# 边缘身份头签名密钥，至少 32 字符，须与认证服务一致。
HIERARCHY_EDGE_SIGNING_SECRET=
# 内部接口服务级密钥，至少 32 字符，须与认证服务一致。
HIERARCHY_EDGE_SERVICE_KEY=
