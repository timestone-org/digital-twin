# knowledge-server：Windows NSSM 配置模板（UTF-8 无 BOM）。
# 部署手册：docs/DEPLOY_WINDOWS_NSSM.md

# ---- 进程 ----
KNOWLEDGE_APP_NAME=knowledge-server
# 默认 api；NSSM 给 worker 独立角色和 INSTANCE，worker 不监听 HTTP。
KNOWLEDGE_APP_ROLE=api
KNOWLEDGE_APP_INSTANCE=dt-knowledge
KNOWLEDGE_APP_LOG_LEVEL=INFO
KNOWLEDGE_APP_LOG_FORMAT=json
KNOWLEDGE_APP_HTTP_HOST=127.0.0.1
KNOWLEDGE_APP_HTTP_PORT=8009
KNOWLEDGE_APP_DRAIN_TIMEOUT_S=20.0
KNOWLEDGE_APP_TRACE_SAMPLE_RATIO=0.1

# ---- Postgres ----
KNOWLEDGE_POSTGRES_HOST=127.0.0.1
KNOWLEDGE_POSTGRES_PORT=5432
# 必填数据库账号与口令；各服务共用同一实例和数据库。
KNOWLEDGE_POSTGRES_USER=postgres
KNOWLEDGE_POSTGRES_PASSWORD=
KNOWLEDGE_POSTGRES_DB=dt_db
KNOWLEDGE_POSTGRES_SCHEMA=knowledge
KNOWLEDGE_POSTGRES_POOL_SIZE=10
KNOWLEDGE_POSTGRES_POOL_OVERFLOW=5
KNOWLEDGE_POSTGRES_CONNECT_TIMEOUT_S=5.0
KNOWLEDGE_POSTGRES_STATEMENT_TIMEOUT_MS=2000
KNOWLEDGE_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- Redis ----
KNOWLEDGE_REDIS_HOST=127.0.0.1
KNOWLEDGE_REDIS_PORT=6379
# 可选现场口令；null 表示不认证，跨服务须一致。
KNOWLEDGE_REDIS_PASSWORD=null
KNOWLEDGE_REDIS_DB=0
KNOWLEDGE_REDIS_TIMEOUT_S=1.0

# ---- 对象存储：上传来源的原件落在这里 ----
KNOWLEDGE_OBJECTSTORE_ENDPOINT=http://127.0.0.1:9000
KNOWLEDGE_OBJECTSTORE_PUBLIC_BASE=/oss/
KNOWLEDGE_OBJECTSTORE_BUCKET=digitaltwin
# ACCESS_KEY/SECRET_KEY 必填，与平台及 MinIO 同值。
KNOWLEDGE_OBJECTSTORE_ACCESS_KEY=
KNOWLEDGE_OBJECTSTORE_SECRET_KEY=
KNOWLEDGE_OBJECTSTORE_REGION=us-east-1
KNOWLEDGE_OBJECTSTORE_PATH_STYLE_ENABLED=true
KNOWLEDGE_OBJECTSTORE_CONNECT_TIMEOUT_S=3.0
KNOWLEDGE_OBJECTSTORE_READ_TIMEOUT_S=10.0
KNOWLEDGE_OBJECTSTORE_MAX_ATTEMPTS=2

# ---- 边缘 ----
# 两枚边缘密钥必填且至少 32 字符；与 auth 对应字段同值。
KNOWLEDGE_EDGE_SIGNING_SECRET=
KNOWLEDGE_EDGE_SERVICE_KEY=

# ---- 上游业务面（外部系统来源经它取数，不读别人的库）----
KNOWLEDGE_PLATFORM_BASE_URL=http://127.0.0.1:8005
KNOWLEDGE_PLATFORM_TIMEOUT_S=10.0
# 平台模型目录刷新间隔，单位秒；目录分配优先。
KNOWLEDGE_LLM_CATALOG_REFRESH_S=10.0
KNOWLEDGE_LLM_CATALOG_TIMEOUT_S=3.0
# 领取平台订阅令牌的预算，单位秒；仅领取，不刷新。
KNOWLEDGE_LLM_LOGIN_TIMEOUT_S=15

# ---- 嵌入档：模型目录没分配时的永久默认值 ----
# 可选环境嵌入档；目录分配优先，启用须配齐端点、模型与密钥。
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_API_KEY=null
KNOWLEDGE_EMBEDDING_MODEL=
# 向量维数；须与模型及迁移建立的 vector(N) 一致。
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_TIMEOUT_S=30.0
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
# 嵌入输入窗口，单位 token；切块上限由此折算。
KNOWLEDGE_EMBEDDING_MAX_INPUT_TOKENS=512
# 最小块长度，单位 token；不足时跨标题合并。
KNOWLEDGE_CHUNK_MIN_TOKENS=80
# 相邻块重叠字符数，避免边界信息丢失。
KNOWLEDGE_CHUNK_OVERLAP_CHARS=120

# ---- 对话档：只决定 agentic 检索策略可不可用 ----
KNOWLEDGE_MODEL_ENABLED=false
KNOWLEDGE_MODEL_BASE_URL=
KNOWLEDGE_MODEL_API_KEY=null
KNOWLEDGE_MODEL_CHAT=
KNOWLEDGE_MODEL_TIMEOUT_S=60.0
# 对话窗口，单位 token；0 表示未知，按端点实际窗口填写。
KNOWLEDGE_MODEL_CONTEXT_TOKENS=0
# 模型连续失败阈值；401/403/400 不计入。
KNOWLEDGE_MODEL_BREAKER_FAILURES=5
KNOWLEDGE_MODEL_BREAKER_RESET_S=30.0

# ---- 重排档（ADR-0042）----
# 重排预算，单位秒；模型仅从平台目录分配，失败保留融合排序。
KNOWLEDGE_RERANK_TIMEOUT_S=15.0

# ---- 摄取队列（worker 角色读它）----
# 摄取队列名；API 与 worker 必须完全一致。
KNOWLEDGE_INGEST_STREAM=knowledge:ingest
KNOWLEDGE_INGEST_GROUP=knowledge-ingest-workers
# 整份摄取预算，单位秒；须大于解析与 Office 预览预算之和。
KNOWLEDGE_INGEST_TIMEOUT_S=1800.0
KNOWLEDGE_INGEST_CLAIM_IDLE_MS=300000
# 升级先 false，全部 worker 更新后 true；新安装可 true。
KNOWLEDGE_INGEST_GENERATION_WRITE_ENABLED=false
KNOWLEDGE_INGEST_BLOCK_MS=5000
KNOWLEDGE_INGEST_BATCH=1
KNOWLEDGE_PARSE_TIMEOUT_S=600.0
# worker 的 DOCX 派生预览；启用需 LibreOffice，false 使用兼容预览。
KNOWLEDGE_OFFICE_PREVIEW_ENABLED=true
KNOWLEDGE_OFFICE_PREVIEW_COMMAND=C:/Program Files/LibreOffice/program/soffice.com
KNOWLEDGE_OFFICE_PREVIEW_TIMEOUT_S=300.0
# 外部解析投任务和轮询的总预算，单位秒。
KNOWLEDGE_EXTERNAL_PARSE_TIMEOUT_S=180.0

# ---- 外部解析服务 MinerU（ADR-0043）：PDF 与扫描件走它 ----
# 可选 PDF/OCR 解析；启用时必须填写 HTTP(S) 服务地址。
KNOWLEDGE_MINERU_ENABLED=false
KNOWLEDGE_MINERU_BASE_URL=
# OCR 语言，原样发送给 MinerU。
KNOWLEDGE_MINERU_LANG=ch
KNOWLEDGE_MINERU_FORMULA_ENABLED=true
KNOWLEDGE_MINERU_TABLE_ENABLED=true

# ---- 索引：没有开关（ADR-0045）----

# ---- 语音输入（ADR-0038）：到自建 FunASR 的中继 ----
# 可选语音转写；启用时必须填写 ws:// 或 wss:// 地址。
KNOWLEDGE_ASR_ENABLED=false
KNOWLEDGE_ASR_URL=
# 可选热词字符串，原样发送给 FunASR。
KNOWLEDGE_ASR_HOTWORDS=
KNOWLEDGE_ASR_CONNECT_TIMEOUT_S=5.0
# 停止录音后等待终稿的预算，单位秒。
KNOWLEDGE_ASR_FINAL_TIMEOUT_S=5.0
# 浏览器未送音频的最长等待时间，单位秒。
KNOWLEDGE_ASR_IDLE_TIMEOUT_S=30.0
# 单次录音上限，单位秒。
KNOWLEDGE_ASR_MAX_UTTERANCE_S=60.0
# 录音末尾补静音的长度，单位秒，帮助 VAD 识别句末。
KNOWLEDGE_ASR_TAIL_SILENCE_S=3.0
