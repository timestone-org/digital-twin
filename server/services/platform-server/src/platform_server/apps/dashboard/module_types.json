{
  "catalog_version": 1,
  "modules": [
    {
      "type": "container",
      "display_name": "容器",
      "category": "布局",
      "icon": "layout-template",
      "keywords": [
        "container",
        "rongqi",
        "容器",
        "分组",
        "面板"
      ],
      "default_size": {
        "width": 640,
        "height": 432,
        "min_width": 120,
        "min_height": 80
      },
      "chrome": "bare",
      "is_container": true,
      "version": 1,
      "config_schema": [
        {
          "key": "title",
          "label": "标题",
          "type": "string",
          "default": "",
          "placeholder": "留空则标题条上没有文字",
          "group": "标题",
          "span": "full",
          "when": {
            "key": "showTitle",
            "in": [
              true
            ]
          }
        },
        {
          "key": "showTitle",
          "label": "显示标题条",
          "type": "boolean",
          "default": true,
          "group": "标题",
          "span": "half"
        },
        {
          "key": "accent",
          "label": "强调色",
          "type": "color",
          "default": "var(--accent-primary)",
          "group": "外观",
          "help": "标题竖条与内容区点阵取这个色。",
          "span": "half"
        },
        {
          "key": "background",
          "label": "背景",
          "type": "color",
          "default": "",
          "placeholder": "留空 = 透明，继承大屏背景",
          "group": "外观",
          "span": "half"
        },
        {
          "key": "backgroundImage",
          "label": "背景图 / 渐变",
          "type": "string",
          "default": "",
          "placeholder": "留空 = 无；填 CSS：linear-gradient(…) 或 url(…)",
          "group": "外观",
          "help": "叠在背景色之上的 CSS background-image 值；留空不注入，纯色背景不受影响。",
          "span": "full"
        },
        {
          "key": "radius",
          "label": "圆角 (px)",
          "type": "number",
          "default": 4,
          "group": "外观",
          "span": "half",
          "min": 0,
          "max": 32,
          "step": 1
        },
        {
          "key": "showBorder",
          "label": "描边",
          "type": "boolean",
          "default": false,
          "group": "外观",
          "help": "描边颜色取卡片外观里的边框色。",
          "span": "half"
        },
        {
          "key": "borderWidth",
          "label": "描边粗细 (px)",
          "type": "number",
          "default": 1,
          "group": "外观",
          "span": "half",
          "when": {
            "key": "showBorder",
            "in": [
              true
            ]
          },
          "min": 0,
          "max": 8,
          "step": 1
        },
        {
          "key": "showDotGrid",
          "label": "点阵底纹",
          "type": "boolean",
          "default": true,
          "group": "外观",
          "help": "内容区铺一层点阵，示意子节点的可放置范围。",
          "span": "half"
        },
        {
          "key": "dotSize",
          "label": "点径 (px)",
          "type": "number",
          "default": 1,
          "group": "外观",
          "span": "half",
          "when": {
            "key": "showDotGrid",
            "in": [
              true
            ]
          },
          "min": 1,
          "max": 6,
          "step": 1
        },
        {
          "key": "dotGap",
          "label": "点距 (px)",
          "type": "number",
          "default": 16,
          "group": "外观",
          "span": "half",
          "when": {
            "key": "showDotGrid",
            "in": [
              true
            ]
          },
          "min": 4,
          "max": 64,
          "step": 1
        },
        {
          "key": "dotOpacity",
          "label": "点阵浓度",
          "type": "number",
          "default": 0.12,
          "group": "外观",
          "span": "half",
          "when": {
            "key": "showDotGrid",
            "in": [
              true
            ]
          },
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "key": "__container",
          "label": "内部布局",
          "type": "object",
          "default": {
            "pad": 8
          },
          "group": "布局",
          "help": "子节点摆在内容区里，内边距决定内容区比容器矩形小多少。",
          "fields": [
            {
              "key": "pad",
              "label": "内边距 (px)",
              "type": "number",
              "default": 8,
              "min": 0,
              "max": 64,
              "step": 1
            }
          ]
        }
      ],
      "bindings": []
    },
    {
      "type": "footer",
      "display_name": "页脚",
      "category": "布局",
      "icon": "panel-bottom",
      "keywords": [
        "footer",
        "yejiao",
        "页脚",
        "底部",
        "页尾"
      ],
      "default_size": {
        "width": 1920,
        "height": 72,
        "min_width": 240,
        "min_height": 40
      },
      "chrome": "bare",
      "is_container": true,
      "region": "footer",
      "version": 1,
      "config_schema": [
        {
          "key": "title",
          "label": "标题",
          "type": "string",
          "default": "",
          "placeholder": "留空则标题条上没有文字",
          "group": "标题",
          "span": "full",
          "when": {
            "key": "showTitle",
            "in": [
              true
            ]
          }
        },
        {
          "key": "showTitle",
          "label": "显示标题条",
          "type": "boolean",
          "default": false,
          "group": "标题",
          "span": "half"
        },
        {
          "key": "titleAlign",
          "label": "标题对齐",
          "type": "enum",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "靠左"
            },
            {
              "value": "center",
              "label": "居中"
            },
            {
              "value": "right",
              "label": "靠右"
            }
          ],
          "group": "标题",
          "span": "half",
          "when": {
            "key": "showTitle",
            "in": [
              true
            ]
          }
        },
        {
          "key": "accent",
          "label": "强调色",
          "type": "color",
          "default": "var(--accent-primary)",
          "group": "外观",
          "help": "顶部分隔线与扫光取这个色。",
          "span": "half"
        },
        {
          "key": "background",
          "label": "背景",
          "type": "color",
          "default": "",
          "placeholder": "留空 = 透明，继承大屏背景",
          "group": "外观",
          "span": "half"
        },
        {
          "key": "backgroundImage",
          "label": "背景图 / 渐变",
          "type": "string",
          "default": "",
          "placeholder": "留空 = 无；填 CSS：linear-gradient(…) 或 url(…)",
          "group": "外观",
          "help": "叠在背景色之上的 CSS background-image 值；留空不注入，纯色背景不受影响。",
          "span": "full"
        },
        {
          "key": "showDivider",
          "label": "顶部分隔线",
          "type": "boolean",
          "default": true,
          "group": "外观",
          "span": "half"
        },
        {
          "key": "dividerWidth",
          "label": "分隔线粗细 (px)",
          "type": "number",
          "default": 1,
          "group": "外观",
          "span": "half",
          "when": {
            "key": "showDivider",
            "in": [
              true
            ]
          },
          "min": 0,
          "max": 8,
          "step": 1
        },
        {
          "key": "showSweep",
          "label": "顶边扫光",
          "type": "boolean",
          "default": true,
          "group": "外观",
          "help": "顶边一条由强调色渐隐的高光带，纯装饰。",
          "span": "half"
        },
        {
          "key": "sweepOpacity",
          "label": "扫光浓度",
          "type": "number",
          "default": 0.6,
          "group": "外观",
          "span": "half",
          "when": {
            "key": "showSweep",
            "in": [
              true
            ]
          },
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "showDotGrid",
          "label": "点阵底纹",
          "type": "boolean",
          "default": false,
          "group": "外观",
          "help": "内容区铺一层点阵，示意子节点的可放置范围。",
          "span": "half"
        },
        {
          "key": "__container",
          "label": "内部布局",
          "type": "object",
          "default": {
            "pad": 8
          },
          "group": "布局",
          "help": "子节点摆在内容区里，内边距决定内容区比页脚矩形小多少。",
          "fields": [
            {
              "key": "pad",
              "label": "内边距 (px)",
              "type": "number",
              "default": 8,
              "min": 0,
              "max": 64,
              "step": 1
            }
          ]
        }
      ],
      "bindings": []
    },
    {
      "type": "header",
      "display_name": "页头",
      "category": "布局",
      "icon": "layout-grid",
      "keywords": [
        "header",
        "yetou",
        "页头",
        "顶部",
        "标题栏"
      ],
      "default_size": {
        "width": 1920,
        "height": 108,
        "min_width": 240,
        "min_height": 48
      },
      "chrome": "bare",
      "is_container": true,
      "region": "header",
      "version": 1,
      "config_schema": [
        {
          "key": "title",
          "label": "标题",
          "type": "string",
          "default": "",
          "placeholder": "留空则标题条上没有文字",
          "group": "标题",
          "span": "full",
          "when": {
            "key": "showTitle",
            "in": [
              true
            ]
          }
        },
        {
          "key": "showTitle",
          "label": "显示标题条",
          "type": "boolean",
          "default": false,
          "group": "标题",
          "span": "half"
        },
        {
          "key": "variant",
          "label": "风格",
          "type": "enum",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "默认（斜纹）"
            },
            {
              "value": "winged",
              "label": "翼形"
            },
            {
              "value": "glass",
              "label": "玻璃（点阵）"
            },
            {
              "value": "minimal",
              "label": "极简"
            },
            {
              "value": "ribbon",
              "label": "飘带（人字纹）"
            },
            {
              "value": "plain",
              "label": "素净（无花纹）"
            },
            {
              "value": "podium",
              "label": "翼台"
            }
          ],
          "group": "外观"
        },
        {
          "key": "deco",
          "label": "标题装饰",
          "type": "enum",
          "default": "bars",
          "options": [
            {
              "value": "none",
              "label": "无"
            },
            {
              "value": "bars",
              "label": "横线"
            },
            {
              "value": "slash",
              "label": "斜切条"
            },
            {
              "value": "chevron",
              "label": "箭头"
            },
            {
              "value": "diamond",
              "label": "菱标"
            },
            {
              "value": "dashed",
              "label": "分段线"
            }
          ],
          "group": "外观",
          "help": "标题两侧的对称装饰；选「无」即不添加。"
        },
        {
          "key": "decoGap",
          "label": "装饰中缝",
          "type": "number",
          "default": 0,
          "group": "外观",
          "help": "两侧装饰之间给标题留的空 (px)；0 = 随宽度自适应。子节点较宽或屏幕较窄时调大它避免重叠。",
          "when": {
            "key": "deco",
            "in": [
              "bars",
              "slash",
              "chevron",
              "diamond",
              "dashed"
            ]
          },
          "min": 0,
          "max": 800,
          "step": 10
        },
        {
          "key": "accent",
          "label": "强调色",
          "type": "color",
          "default": "var(--accent-primary)",
          "group": "外观",
          "help": "花纹、装饰条、底部分隔线与标题辉光都取这个色。",
          "span": "half"
        },
        {
          "key": "background",
          "label": "背景",
          "type": "color",
          "default": "",
          "placeholder": "留空 = 透明，继承大屏背景",
          "group": "外观",
          "span": "half"
        },
        {
          "key": "bgImage",
          "label": "背景底图",
          "type": "image",
          "default": "",
          "placeholder": "留空 = 用风格自带花纹",
          "group": "外观",
          "help": "可填图片地址（自动铺成整宽贴底），也可直接填 CSS background 简写 / 渐变；填 var(--fx-decor-topbg) 用内置的倒角横带底图。",
          "span": "full"
        },
        {
          "key": "bgFilter",
          "label": "底图滤镜",
          "type": "string",
          "default": "",
          "placeholder": "留空 = 跟随主题装饰滤镜",
          "group": "外观",
          "help": "只作用在底图那一层上。留空时走主题的 var(--fx-decor-filter)；也可自填 hue-rotate(30deg) 之类。",
          "span": "full"
        },
        {
          "key": "glowLineInset",
          "label": "底线内缩",
          "type": "number",
          "default": 0,
          "group": "外观",
          "help": "底部辉光分隔线左右各内缩的百分比。0 = 整条贯通；填 10 则只有中间八成有线。",
          "when": {
            "key": "variant",
            "in": [
              "default",
              "winged",
              "glass",
              "minimal",
              "ribbon"
            ]
          },
          "min": 0,
          "max": 49,
          "step": 1
        },
        {
          "key": "glowLineGlow",
          "label": "底线外发光",
          "type": "boolean",
          "default": true,
          "group": "外观",
          "help": "关掉后只剩 1px 渐变线本体，观感更硬朗。",
          "when": {
            "key": "variant",
            "in": [
              "default",
              "winged",
              "glass",
              "minimal",
              "ribbon"
            ]
          }
        },
        {
          "key": "scanlines",
          "label": "CRT 扫描线",
          "type": "boolean",
          "default": true,
          "group": "动效",
          "help": "页头表面的横向扫描线纹理。",
          "when": {
            "key": "variant",
            "in": [
              "default",
              "winged",
              "glass",
              "minimal",
              "ribbon",
              "podium"
            ]
          }
        },
        {
          "key": "scan",
          "label": "横向扫光",
          "type": "boolean",
          "default": false,
          "group": "动效",
          "help": "一条自左向右循环掠过页头的渐变光带。",
          "when": {
            "key": "variant",
            "in": [
              "default",
              "winged",
              "glass",
              "minimal",
              "ribbon",
              "podium"
            ]
          }
        },
        {
          "key": "scanWidth",
          "label": "扫光宽度",
          "type": "number",
          "default": 30,
          "group": "动效",
          "help": "光带宽度占页头宽度的百分比。行程固定为 -30% → 130%，宽度偏离 30 太多时两端会有跳入感。",
          "when": {
            "key": "scan",
            "in": [
              true
            ]
          },
          "min": 1,
          "max": 100,
          "step": 1
        },
        {
          "key": "scanDuration",
          "label": "扫光周期",
          "type": "number",
          "default": 4,
          "group": "动效",
          "help": "光带匀速跑完一趟的秒数，循环播放。",
          "when": {
            "key": "scan",
            "in": [
              true
            ]
          },
          "min": 0.5,
          "max": 60,
          "step": 0.5
        },
        {
          "key": "scanColor",
          "label": "扫光颜色",
          "type": "color",
          "default": "var(--card-border)",
          "group": "动效",
          "help": "光带中心色，两端自动淡出为透明。",
          "when": {
            "key": "scan",
            "in": [
              true
            ]
          }
        },
        {
          "key": "scanAbove",
          "label": "扫光置顶",
          "type": "boolean",
          "default": true,
          "group": "动效",
          "help": "开着时光带盖在花纹与扫描线之上，是「光扫过标题」的手感；关掉则沉到花纹层附近。子节点始终在光带之上。",
          "when": {
            "key": "scan",
            "in": [
              true
            ]
          }
        },
        {
          "key": "__container",
          "label": "内部布局",
          "type": "object",
          "default": {
            "pad": 8
          },
          "group": "布局",
          "help": "子节点摆在内容区里，内边距决定内容区比页头矩形小多少。",
          "fields": [
            {
              "key": "pad",
              "label": "内边距 (px)",
              "type": "number",
              "default": 8,
              "min": 0,
              "max": 64,
              "step": 1
            }
          ]
        }
      ],
      "bindings": []
    },
    {
      "type": "image-block",
      "display_name": "图片块",
      "category": "装饰",
      "icon": "image",
      "keywords": [
        "image",
        "picture",
        "tupian",
        "图片",
        "图",
        "logo"
      ],
      "default_size": {
        "width": 240,
        "height": 108,
        "min_width": 40,
        "min_height": 24
      },
      "chrome": "bare",
      "version": 1,
      "config_schema": [
        {
          "key": "title",
          "label": "标题",
          "type": "string",
          "default": "",
          "placeholder": "留空则不画标题栏",
          "group": "内容",
          "span": "full"
        },
        {
          "key": "src",
          "label": "图片",
          "type": "image",
          "default": "",
          "placeholder": "https://… 或 linear-gradient(…)",
          "group": "内容",
          "help": "填图片地址按图片画；填 CSS 值（渐变 / url() / var()）按背景画。",
          "span": "full"
        },
        {
          "key": "alt",
          "label": "替代文字",
          "type": "string",
          "default": "",
          "group": "内容",
          "help": "读屏时念出来的一句话；纯装饰图留空即可。",
          "span": "full"
        },
        {
          "key": "emptyText",
          "label": "未配图文案",
          "type": "string",
          "default": "未设置图片",
          "group": "内容",
          "help": "没填图片时画在方块里的一句话；留空则一个字都不显示。",
          "span": "half"
        },
        {
          "key": "errorText",
          "label": "加载失败文案",
          "type": "string",
          "default": "图片加载失败",
          "group": "内容",
          "help": "取不回图时画在方块里的一句话；留空则一个字都不显示。",
          "span": "half"
        },
        {
          "key": "fit",
          "label": "填充方式",
          "type": "enum",
          "default": "contain",
          "options": [
            {
              "value": "contain",
              "label": "完整"
            },
            {
              "value": "cover",
              "label": "裁剪填满"
            },
            {
              "value": "fill",
              "label": "拉伸"
            }
          ],
          "group": "画面",
          "span": "half"
        },
        {
          "key": "position",
          "label": "裁剪定位",
          "type": "enum",
          "default": "center",
          "options": [
            {
              "value": "center",
              "label": "居中"
            },
            {
              "value": "top",
              "label": "上"
            },
            {
              "value": "bottom",
              "label": "下"
            },
            {
              "value": "left",
              "label": "左"
            },
            {
              "value": "right",
              "label": "右"
            }
          ],
          "group": "画面",
          "help": "「裁剪填满」时保住画面的哪一侧。",
          "span": "half"
        },
        {
          "key": "repeat",
          "label": "平铺",
          "type": "enum",
          "default": "no-repeat",
          "options": [
            {
              "value": "no-repeat",
              "label": "不平铺"
            },
            {
              "value": "repeat",
              "label": "双向平铺"
            },
            {
              "value": "repeat-x",
              "label": "横向平铺"
            },
            {
              "value": "repeat-y",
              "label": "纵向平铺"
            }
          ],
          "group": "画面",
