# platform-server 配置模板。生产只用环境变量，本文件是本地开发的便利。
# 标「必填」的项没有默认值，缺失即拒绝启动；其余项写的就是代码里的默认值。
# ⚠ 本文件必须列全部变量：漏一项，下一个部署的人会撞上一个没有文档的启动失败。

# ---- 进程 ----
PLATFORM_APP_NAME=platform-server
PLATFORM_APP_ROLE=api
# 留空则取主机名，用于在日志里区分副本
PLATFORM_APP_INSTANCE=
PLATFORM_APP_LOG_LEVEL=INFO
PLATFORM_APP_LOG_FORMAT=json
PLATFORM_APP_HTTP_HOST=0.0.0.0
PLATFORM_APP_HTTP_PORT=8005
# 优雅关停时等待在途请求的上限，必须小于编排器的宽限期
PLATFORM_APP_DRAIN_TIMEOUT_S=20.0
PLATFORM_APP_TRACE_SAMPLE_RATIO=0.1

# ---- PostgreSQL（必填：host / user / password / db）----
PLATFORM_POSTGRES_HOST=
PLATFORM_POSTGRES_PORT=5432
PLATFORM_POSTGRES_USER=
PLATFORM_POSTGRES_PASSWORD=
PLATFORM_POSTGRES_DB=
PLATFORM_POSTGRES_SCHEMA=platform
PLATFORM_POSTGRES_POOL_SIZE=10
PLATFORM_POSTGRES_POOL_OVERFLOW=5
PLATFORM_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 热路径语句超时，见 docs/agents/runtime-resilience.md §3.1
PLATFORM_POSTGRES_STATEMENT_TIMEOUT_MS=2000
PLATFORM_POSTGRES_LOCK_TIMEOUT_MS=3000

# ---- 外部只读数据源（必填：host / user / password / database）----
# 现场能源管理系统的 SQL Server 库。只读：只跑 SELECT，不建表、不迁移。
PLATFORM_SQLSERVER_HOST=
PLATFORM_SQLSERVER_PORT=1433
PLATFORM_SQLSERVER_USER=
PLATFORM_SQLSERVER_PASSWORD=
PLATFORM_SQLSERVER_DATABASE=
PLATFORM_SQLSERVER_LOGIN_TIMEOUT_S=5.0
# 聚合类查询预算，见 docs/agents/runtime-resilience.md §3.1
PLATFORM_SQLSERVER_QUERY_TIMEOUT_S=15.0
PLATFORM_SQLSERVER_POOL_SIZE=5
PLATFORM_SQLSERVER_POOL_RECYCLE_S=3600
# 驱动的客户端字符集。⚠ 配错只出乱码不报错，且开发机与容器表现可能不同
PLATFORM_SQLSERVER_CHARSET=UTF-8
# 外库时间列的时区口径。库里存的是 naive 当地时，对外一律 UTC
PLATFORM_ACSOURCE_TIMEZONE=Asia/Shanghai

# ---- 边缘（必填）----
# 校验边缘注入的身份头用。**必须与 AUTH_EDGE_SIGNING_SECRET 取同一个值**：
# 少配一边就是全链路 401，而现象与原因隔得极远
PLATFORM_EDGE_SIGNING_SECRET=
