      "name": "2# 分钟产气量",
      "source": "formula",
      "formula": "IF(AND(COUNT_OVER({volume_2}, '2m') == 2, {volume_2} >= PREV({volume_2})), {volume_2} - PREV({volume_2}), None)",
      "unit": "m³/min",
      "decimals": 3
    },
