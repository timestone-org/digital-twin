# 复制为 docker/.env.storage 并填齐空白项；可选项按需取消注释。

# PostgreSQL 首次初始化的数据库名，应用连接须使用同名数据库。
POSTGRES_DB=dt_db
# PostgreSQL 首次初始化的管理员账号，应用默认可用同一账号。
POSTGRES_USER=postgres
# PostgreSQL 初始化口令，必填；已有数据卷通过数据库管理命令修改口令。
POSTGRES_PASSWORD=

# Redis 默认账号的登录口令，必填且避免使用保留值 null。
REDIS_PASSWORD=

# MinIO 管理账号，必填且至少 3 字符。
OSS_ACCESS_KEY=
# MinIO 管理口令，必填且至少 8 字符。
OSS_SECRET_KEY=
# 初始化作业创建的对象存储桶名称，平台与知识库须填写同名桶。
# OSS_BUCKET=digitaltwin

# 数据库、Redis 与 MinIO 发布端口的宿主监听 IP，默认仅本机可达。
# STORAGE_BIND_ADDRESS=127.0.0.1
# PostgreSQL 发布到宿主的端口，Docker 网络内仍用 5432。
# STORAGE_POSTGRES_PORT=5432
# Redis 发布到宿主的端口，Docker 网络内仍用 6379。
# STORAGE_REDIS_PORT=6379
# MinIO S3 API 发布到宿主的端口，Docker 网络内仍用 9000。
# STORAGE_MINIO_API_PORT=9000
# MinIO 管理控制台发布到宿主的端口。
# MINIO_CONSOLE_PORT=9001
# 基础设施的 Docker 网络名；完整栈容器使用同一个网络名连接。
# STORAGE_NETWORK_NAME=digitaltwin-storage

# POSTGRES_INITDB_ARGS 固定启用 SCRAM 主机认证，仅在初始化空卷时生效。
# MINIO_ROOT_USER 由 OSS_ACCESS_KEY 注入，用于启动 MinIO 并管理存储。
# MINIO_ROOT_PASSWORD 由 OSS_SECRET_KEY 注入，用于 MinIO 管理账号认证。
# OSS_ENDPOINT 固定为 http://minio:9000，供容器内建桶作业连接。
