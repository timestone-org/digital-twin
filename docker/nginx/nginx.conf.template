# edge-gateway —— 唯一的入口。
#
# ⚠ 这是 envsubst 模板：官方 nginx 镜像在启动时渲染 /etc/nginx/templates/*.template。
# 必须设 NGINX_ENVSUBST_FILTER='^(AUTH_|OSS_)'，且过滤器只能这么窄：放开的话
# $uri / $host / $request_uri 这些 nginx 变量会被一起替换成空串。
# 它做且只做：TLS 终结、按前缀反代、auth_request 前置鉴权、公开面限流、静态资源发布。
# 它不做：业务逻辑、数据聚合、协议转换。

worker_processes auto;

events {
  worker_connections 2048;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  server_tokens off;

  # /verify 的响应头里带 base64 权限集，默认 4k 的缓冲会截断
  proxy_buffer_size 8k;
  proxy_buffers     8 8k;

  log_format json escape=json '{"ts":"$time_iso8601","status":$status,'
    '"method":"$request_method","uri":"$uri","rt":$request_time,'
    '"trace":"$http_traceparent"}';
  access_log /dev/stdout json;

  # 公开面是可枚举凭据的爆破面，必须限流
  limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
  # 公开大屏免认证且每次都打一次库，同样要有闸
  limit_req_zone $binary_remote_addr zone=public_dashboard:10m rate=60r/m;

  # WebSocket 升级要的 Connection 头：只有客户端确实在升级时才置 upgrade，
  # 恒置的话普通请求的连接复用会被打断
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # Docker 内嵌 DNS。上游地址一律走**运行期解析**，见下方 $*_upstream 的说明。
  # ⚠ ipv6=off 不能省：内嵌 DNS 会回 AAAA，而容器没有 IPv6 路由，
  # 连过去只能等到超时，表现是每个请求都慢几秒后 502。
  resolver 127.0.0.11 valid=10s ipv6=off;
  # ⚠ 解析超时不受 proxy_connect_timeout 管，默认 30s 会让 /_auth 那条
  # 500ms 的预算形同虚设——DNS 一抖动，全站请求挂在解析上。
  resolver_timeout 2s;

  # 上游地址。⚠ 刻意**不用** `upstream {}` 块：开源版 nginx 对块里的主机名是
  # 启动时解析一次、把 IP 固化进内存，之后永不重查。后端容器一被重建就换 IP，
  # 而边缘不参与后端镜像的构建、`up -d --build` 不会重建它，于是它抱着一个
  # 已经不存在的地址一直打，全站 /api 一律 502 且**不会自愈**，只有重启边缘才好。
  # 写成变量后 proxy_pass 走 resolver，每 10s 重新解析一次，IP 漂移自愈。
  # ⚠ 变量式 proxy_pass 不会自动补请求 URI，每处都要显式写 $request_uri。
  map $host $auth_upstream     { default 'auth-server:8004'; }
  map $host $platform_upstream { default 'platform-server:8005'; }
  # ⚠ 只有 opcua-server 的 HTTP 管理面在这里。实例的 opc.tcp 端口是二进制 TCP，
  # http block 转不了，由编排层直接映射端口段，不经边缘（见 ADR-0006）。
  map $host $opcua_upstream    { default 'opcua-server:8008'; }
  map $host $realtime_upstream { default 'realtime-hub:8000'; }
  # AI 助手。⚠ 它可缺席：这套部署不起 ai-assistant 时，这几条 location 会 502，
  # 而前端的能力探测把任何失败都读成「没有助手」，入口于是干净地不出现。
  map $host $assistant_upstream { default 'ai-assistant:8006'; }
  # 素材字节面。⚠ 字节永远不穿过 platform：一个 200MB 的模型经过 API 进程
  # 会把一个 worker 占住几十秒。
  # ⚠ 对象存储在本编排之外（与库同档），故这里是取自环境的 host:port 而不是
  # 服务名；取值带上 http:// 会拼成 `http://http://…`，表现是 /oss/ 一律 502。
  map $host $oss_upstream      { default '${OSS_UPSTREAM}'; }

  # 鉴权子请求要回答的是「客户端在访问哪条路径」。
  # ⚠ 子请求里 $uri 是子请求自己的 /_auth，拿它去问规则表一律 no_matching_rule → 全站 403；
  # 只有 $request_uri 继承自父请求。但它带查询串，而规则是对 path 做 fnmatch，
  # 带上 ?a=b 会让 /api/v1/auth/health 这类精确规则错过，故在这里剥掉查询串。
  map $request_uri $original_path {
    default              $request_uri;
    "~^(?<path_only>[^?]*)\?" $path_only;
  }

  server {
    listen 80;

    # ⚠ 客户端伪造这几个头就等于伪造身份，server 级先一律置空
    proxy_set_header X-Auth-User-Id   "";
    proxy_set_header X-Auth-Username  "";
    proxy_set_header X-Auth-Role      "";
    proxy_set_header X-Auth-Permissions "";
    proxy_set_header X-Auth-Permissions-Truncated "";
    proxy_set_header X-Auth-Exp       "";
    proxy_set_header X-Auth-Sig       "";

    # 内部面不对外暴露
    location ^~ /internal/ { deny all; }

    # —— 免认证 location ——
    # ⚠ 规则表里的空 permission_codes 是「任意已登录用户」，不是匿名放行。
    # 匿名可达性只由这几条 location 保证；删掉任何一条都会导致全站无法登录。
    location = /api/v1/auth/sessions {
      limit_req zone=login burst=5 nodelay;
      proxy_pass http://$auth_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }
    location = /api/v1/auth/sessions:refresh {
      proxy_pass http://$auth_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }
    location = /api/v1/auth/sessions:revoke {
      proxy_pass http://$auth_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }
    location = /api/v1/auth/registrations {
      limit_req zone=login burst=3 nodelay;
      proxy_pass http://$auth_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }
    location = /api/v1/auth/health { proxy_pass http://$auth_upstream$request_uri; }
    location = /api/v1/auth/ready  { proxy_pass http://$auth_upstream$request_uri; }
    location = /api/v1/auth/docs   { proxy_pass http://$auth_upstream$request_uri; }
    location = /api/v1/auth/redoc  { proxy_pass http://$auth_upstream$request_uri; }
    location = /api/v1/auth/openapi.json { proxy_pass http://$auth_upstream$request_uri; }

    location = /api/v1/platform/health { proxy_pass http://$platform_upstream$request_uri; }
    location = /api/v1/platform/ready  { proxy_pass http://$platform_upstream$request_uri; }
    location = /api/v1/platform/docs   { proxy_pass http://$platform_upstream$request_uri; }
    location = /api/v1/platform/redoc  { proxy_pass http://$platform_upstream$request_uri; }
    location = /api/v1/platform/openapi.json {
      proxy_pass http://$platform_upstream$request_uri;
    }

    # 公开大屏。⚠ 这是一条**免认证** location，不是漏了 auth-inject：链接的
    # 持有者就是未登录的访客，挂上 auth_request 会让每个公开链接一律 401。
    # 授权凭据是 URL 里那个令牌，由 platform 自己按「已发布」核对。
    # ⚠ `^~` 不能省：少了它，下面 /api/v1/platform/ 那条更短的前缀在存在正则
    # location 时会重新参与竞争，公开链接又会被要求登录。
    location ^~ /api/v1/platform/public-dashboards/ {
      limit_req zone=public_dashboard burst=20 nodelay;
      proxy_pass http://$platform_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }

    # 素材字节。⚠ 这是一条**免认证** location，不是漏了 auth-inject：
    # 大屏是给现场大屏机看的，模型与图片必须像别的静态资源一样能被匿名取到，
    # 而桶里只有三个已验证的前缀是匿名可读的（`staging/` 不在列）。
    # 上传走同一条路：POST 到 /oss/ 落在桶根，凭证里的 policy 自己就是授权。
    # ⚠ `^~` 不能省：存在正则 location 时短前缀会重新参与竞争。
    location ^~ /oss/ {
      # 桶名不出现在对外地址里：换桶只改一个环境变量，存量 asset: 引用不受影响
      rewrite ^/oss/(.*)$ /${OSS_BUCKET}/$1 break;
      # ⚠ 这里是 $uri 不是 $request_uri：上一行 rewrite 刚把路径改写成带桶名的，
      # 而 $request_uri 是改写**前**的原始值，用它等于把桶名丢掉，一律 404。
      proxy_pass http://$oss_upstream$uri$is_args$args;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_http_version 1.1;
      # ⚠ 刻意**不** include proxy-common.conf：那份的 25s 读超时对 200MB 的
      # 模型上传来说太短，而超时切断表现成「传到一半永远卡住」
      proxy_connect_timeout 5s;
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
      # ⚠ 必须关掉请求缓冲：开着的话 nginx 会把整个上传先落到自己的临时盘上，
      # 大模型于是需要双份磁盘，且首字节延迟等于整份上传时间
      proxy_request_buffering off;
      client_max_body_size 512m;
    }

    # —— 受保护面 ——
    location /api/v1/auth/ {
      include /etc/nginx/conf.d/auth-inject.conf;
      proxy_pass http://$auth_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }

    # ⚠ platform 完全依赖这里注入的签名头来认人：它自己不校验令牌。
    # 这个 location 漏了 auth-inject，整个业务面就是一律 401。
    location /api/v1/platform/ {
      include /etc/nginx/conf.d/auth-inject.conf;
      proxy_pass http://$platform_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }

    # OPC UA 服务端的探针与文档，与 auth 同档免认证
    location = /api/v1/opcua/health { proxy_pass http://$opcua_upstream$request_uri; }
    location = /api/v1/opcua/ready  { proxy_pass http://$opcua_upstream$request_uri; }
    location = /api/v1/opcua/docs   { proxy_pass http://$opcua_upstream$request_uri; }
    location = /api/v1/opcua/redoc  { proxy_pass http://$opcua_upstream$request_uri; }
    location = /api/v1/opcua/openapi.json { proxy_pass http://$opcua_upstream$request_uri; }

    location /api/v1/opcua/ {
      auth_request /_auth;
      auth_request_set $opcua_user  $upstream_http_x_auth_user_id;
      auth_request_set $opcua_name  $upstream_http_x_auth_username;
      auth_request_set $opcua_role  $upstream_http_x_auth_role;
      auth_request_set $opcua_perms $upstream_http_x_auth_permissions;
      auth_request_set $opcua_trunc $upstream_http_x_auth_permissions_truncated;
      auth_request_set $opcua_exp   $upstream_http_x_auth_exp;
      auth_request_set $opcua_sig   $upstream_http_x_auth_sig;

      proxy_set_header X-Auth-User-Id   $opcua_user;
      proxy_set_header X-Auth-Username  $opcua_name;
      proxy_set_header X-Auth-Role      $opcua_role;
      proxy_set_header X-Auth-Permissions $opcua_perms;
      proxy_set_header X-Auth-Permissions-Truncated $opcua_trunc;
      proxy_set_header X-Auth-Exp       $opcua_exp;
      proxy_set_header X-Auth-Sig       $opcua_sig;

      proxy_pass http://$opcua_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
    }

    # —— 实时通道 ——
    location = /api/v1/realtime/health { proxy_pass http://$realtime_upstream$request_uri; }
    location = /api/v1/realtime/ready  { proxy_pass http://$realtime_upstream$request_uri; }
    location = /api/v1/realtime/docs   { proxy_pass http://$realtime_upstream$request_uri; }
    location = /api/v1/realtime/redoc  { proxy_pass http://$realtime_upstream$request_uri; }
    location = /api/v1/realtime/openapi.json { proxy_pass http://$realtime_upstream$request_uri; }

    # WebSocket 端点。⚠ 这是一条**免认证** location，不是漏了 auth_request：
    # token 走 Sec-WebSocket-Protocol 子协议，`auth_request` 的子请求带不上它，
    # 挂上去的结果是所有握手一律 401。认证在 hub 内部完成（它自己验签名、
    # 验过期、按主题判权限），见 realtime-hub/CONTEXT.md §6。
    location = /api/v1/realtime/ws {
      proxy_pass http://$realtime_upstream$request_uri;
      # ⚠ 刻意**不** include proxy-common.conf：那份是给请求-响应用的，
      # 里面的 proxy_read_timeout 25s 会切断长连接，而 nginx 不允许在同一个
      # location 里重复声明同一条指令——想覆盖就只能不 include，逐条写全。
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header traceparent       $http_traceparent;
      proxy_http_version 1.1;
      proxy_connect_timeout 5s;

      # ⚠ 这两行缺一条，握手就退化成普通 HTTP 请求，客户端收到 400/426
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection $connection_upgrade;

      # ⚠ 长连接的读写超时。用 proxy-common.conf 里那个 25s 的话，**每条空闲
      # 25 秒的 WS 连接都会被切断**，表现是「前端每隔半分钟重连一次」，
      # 查起来会一路怀疑到应用层去。客户端的心跳周期要小于它。
      proxy_read_timeout  3600s;
      proxy_send_timeout  3600s;
    }

    # —— AI 助手 ——
    location = /api/v1/assistant/health { proxy_pass http://$assistant_upstream$request_uri; }
    location = /api/v1/assistant/ready  { proxy_pass http://$assistant_upstream$request_uri; }
    location = /api/v1/assistant/docs   { proxy_pass http://$assistant_upstream$request_uri; }
    location = /api/v1/assistant/redoc  { proxy_pass http://$assistant_upstream$request_uri; }
    location = /api/v1/assistant/openapi.json {
      proxy_pass http://$assistant_upstream$request_uri;
    }

    # 推进一个回合：**事件流**，一条请求开着几十秒逐步往外吐。
    # ⚠ 正则 location 压过前缀 location，故它必须写在 `/api/v1/assistant/` 之前
    # 才好读——匹配次序上正则本来就先于普通前缀，这里只是让人看得出来。
    location ~ ^/api/v1/assistant/sessions/[^/]+:advance$ {
      include /etc/nginx/conf.d/auth-inject.conf;
      proxy_pass http://$assistant_upstream$request_uri;

      # ⚠ 刻意**不** include proxy-common.conf：那份的 `proxy_read_timeout 25s`
      # 会在模型还在想的时候把连接掐掉，而现象是「助手转了半分钟然后什么都
      # 没发生」——查起来会一路怀疑到模型那边去。nginx 不允许在同一个 location
      # 里重复声明同一条指令，想覆盖就只能不 include、逐条写全。
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header traceparent       $http_traceparent;
      proxy_http_version 1.1;
      proxy_connect_timeout 5s;
      # ⚠ 要比 ASSISTANT_MODEL_TIMEOUT_S 大：小了的话边缘先掐，
      # 服务端那条超时与它的失败分档一次都轮不到
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;

      # ⚠ 这两行缺一条，事件流就退化成「一次性把全部内容攒完再吐」，
      # 界面上表现为整个回合毫无动静、最后突然全部出现——而「一步一步看得见」
      # 正是这个功能的一半（ADR-0023）
      proxy_buffering off;
      proxy_cache off;
      # SSE 经过反代时的老规矩：告诉上游别启用压缩缓冲
      proxy_set_header Connection "";

      # ⚠ 截图与点表都走这条请求体上来。默认 1m 会让每一张截图都 413，
      # 而那条 413 在界面上只是一句「工具失败」
      client_max_body_size 8m;
    }

    # ⚠ 助手完全依赖这里注入的签名头来认人；它转发同一组头去打 platform，
    # 于是「助手能读什么」严格等于「这个用户自己能读什么」。
    location /api/v1/assistant/ {
      include /etc/nginx/conf.d/auth-inject.conf;
      proxy_pass http://$assistant_upstream$request_uri;
      include /etc/nginx/conf.d/proxy-common.conf;
      # 上传点表走这条：几百 KB 的表 base64 之后仍然超过默认的 1m
      client_max_body_size 8m;
    }

    # 鉴权子请求。⚠ auth_request 只能发 GET，故 /verify 是 GET。
    location = /_auth {
      internal;
      proxy_pass http://$auth_upstream/internal/v1/verify;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header X-Original-URI    $original_path;
      proxy_set_header X-Original-Method $request_method;
      proxy_set_header X-Service-Key     "${AUTH_EDGE_SERVICE_KEY}";
      # 全站前置，每个受保护请求过一次，必须快；超时按拒绝处理
      proxy_connect_timeout 500ms;
      proxy_read_timeout    500ms;
    }

    location / {
      root /usr/share/nginx/html;
      # ⚠ 刻意**不**试 `$uri/`：构建产物里有个真实的 `assets/` 目录，而前端也有
      # 一条 `/assets` 路由（素材库）。试目录的话 nginx 会先 301 到 `/assets/`
      # 再因为没有索引页回 403——直接输地址与刷新页面都进不去，而站内点导航
      # 却是好的，于是看着像「只有刷新会坏」。单页应用没有目录索引可言。
      try_files $uri /index.html;
    }
  }
}
