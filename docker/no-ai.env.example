# 复制为 docker/.env.no-ai，填写所有空白必填项。
# 通过 --env-file .env.no-ai -f compose.no-ai.yml 使用；无需加载 compose.yml。
# 以下列全本编排可调输入，带 # 的项按需取消注释；必填密码与密钥无默认值。

# 必填：应用镜像版本号与提交 SHA，例如 0.1.0-<git短SHA>-no-ai。
IMAGE_TAG=
# Web 入口端口，访问 http://localhost:8080/ai/。
EDGE_HTTP_PORT=8080
# MinIO 管理台仅绑定宿主 127.0.0.1。
MINIO_CONSOLE_PORT=9001

# 内置 PostgreSQL / TimescaleDB 主机，保持 postgres。
POSTGRES_HOST=postgres
# 内置 PostgreSQL 端口，保持 5432。
POSTGRES_PORT=5432
# 首次初始化的数据库名。
POSTGRES_DB=digitaltwin
# 首次初始化的数据库账号，同时用于默认业务连接。
POSTGRES_USER=digitaltwin
# 必填：数据库密码。
POSTGRES_PASSWORD=

# 内置 Redis 主机，保持 redis；各服务默认共用 DB 0。
REDIS_HOST=redis
# 内置 Redis 端口，保持 6379。
REDIS_PORT=6379
# 必填：Redis 密码。
REDIS_PASSWORD=

# 内置 MinIO；地址保持原值，浏览器经网关 /oss/ 直传直取。
OSS_ENDPOINT=http://minio:9000
# 网关访问内置 MinIO 的 host:port，不带协议。
OSS_UPSTREAM=minio:9000
# 对象存储桶名称，首次启动自动创建。
OSS_BUCKET=digitaltwin
# 浏览器素材路径，须与 Nginx 的 /oss/ 路由一致。
OSS_PUBLIC_BASE=/oss/
# 必填：MinIO 管理账号，至少 3 字符。
OSS_ACCESS_KEY=
# 必填：MinIO 管理密码，至少 8 字符。
OSS_SECRET_KEY=

# 必填：JWT 签名密钥，至少 32 字符；以下密钥分别独立生成。
AUTH_JWT_SECRET=
# 必填：边缘身份签名密钥，至少 32 字符。
AUTH_EDGE_SIGNING_SECRET=
# 必填：内部接口服务密钥，至少 32 字符。
AUTH_EDGE_SERVICE_KEY=
# 必填：采集凭据加密密钥，至少 32 字符。
COLLECT_CREDENTIAL_SECRET=
# 必填：首次管理员密码，至少 12 字符；已有账号不重设。
AUTH_SEED_ADMIN_PASSWORD=
# 首次创建的管理员用户名，不修改已有账号。
AUTH_SEED_ADMIN_USERNAME=admin
# 首次创建的管理员邮箱，不修改已有账号。
AUTH_SEED_ADMIN_EMAIL=admin@example.com

# 现有 platform Settings 要求这四项必填；填写现场只读 EMS 连接。
# EMS 不属于本编排。暂时不可达时仅空调数据查询不可用，不阻断其余业务。
# 必填：外部只读 EMS SQL Server 主机。
ACSOURCE_HOST=
# 必填：外部只读 EMS 登录账号。
ACSOURCE_USER=
# 必填：外部只读 EMS 登录密码。
ACSOURCE_PASSWORD=
# 必填：外部 EMS 数据库名。
ACSOURCE_DB=
# 外部 EMS SQL Server 端口。
ACSOURCE_PORT=1433
# 外部 EMS 无时区时间列使用的业务时区。
ACSOURCE_TIMEZONE=Asia/Shanghai

# OPC UA 实例端口池；端口映射与服务配置共用该值。
OPCUA_PORT_POOL=4840-4859

# BDM 能管取数（外部业务接口，与 AI 开关无关）

# 需要 BDM 时设 ENABLED=true，并填写 origin 地址和 API Key（32–256个无空白ASCII字符）。
# BASE_URL 只含 http(s)://主机[:端口]，不加 /api 路径、查询参数或账号。
# 请求预算须满足 TIMEOUT_S < LOAD_TIMEOUT_S < PLATFORM_MODELING_NODE_TIMEOUT_S。
# BDM 只读历史接口；启用时 URL 和 API Key 必填，密钥不提交版本库。
# PLATFORM_BDM_ENABLED=false
# HTTP(S) origin，不包含 /api 路径或查询参数。
# PLATFORM_BDM_BASE_URL=
# 由接口提供方分配；只在后端发送 X-API-Key。
# PLATFORM_BDM_API_KEY=
# 上游无时区时间与公式业务周期的时区。
# PLATFORM_BDM_TIMEZONE=Asia/Shanghai
# 单次 HTTP 请求总超时，须小于取数总时限。
# PLATFORM_BDM_TIMEOUT_S=10.0
# 每个源节点的取数总时限，须小于 PLATFORM_MODELING_NODE_TIMEOUT_S。
# PLATFORM_BDM_LOAD_TIMEOUT_S=120.0
# 分析建模单个算子超时秒数。
# PLATFORM_MODELING_NODE_TIMEOUT_S=300.0

# 报告生成与第三方业务 API

# 报告业务 API 连接目录，JSON 数组；地址与认证头仅服务端保存，配置示例见报告设计文档
# PLATFORM_REPORT_API_CONNECTIONS=[]
# 是否启用报告周期自动生成。
# PLATFORM_REPORT_SCHEDULE_ENABLED=false

# 台账采集、时区与历史保留

# 台账日历分桶时区，PLATFORM_DATASET_BUCKET_TIMEZONE 优先。
# DATASET_BUCKET_TIMEZONE=Asia/Shanghai
# 台账周期聚合开关，PLATFORM_DATASET_ENABLED 优先。
# DATASET_ENABLED=false
# 台账周期聚合间隔秒数，PLATFORM_DATASET_INTERVAL_S 优先。
# DATASET_INTERVAL_S=60.0
# 台账聚合租约有效期秒数，PLATFORM_DATASET_LEASE_TTL_S 优先。
# DATASET_LEASE_TTL_S=180
# 台账单表每轮桶数量上限，PLATFORM_DATASET_MAX_BUCKETS_PER_TICK 优先。
# DATASET_MAX_BUCKETS_PER_TICK=240
# 台账最近重算桶数量，PLATFORM_DATASET_RECOMPUTE_TAIL_BUCKETS 优先。
# DATASET_RECOMPUTE_TAIL_BUCKETS=2
# 台账单表每轮超时秒数，PLATFORM_DATASET_TABLE_TIMEOUT_S 优先。
# DATASET_TABLE_TIMEOUT_S=60.0
# 台账按日历分桶使用的业务时区。
# PLATFORM_DATASET_BUCKET_TIMEZONE=Asia/Shanghai
# 是否启用台账周期聚合采集。
# PLATFORM_DATASET_ENABLED=false
# 台账聚合采集间隔秒数。
# PLATFORM_DATASET_INTERVAL_S=60.0
# 台账聚合单活租约有效期秒数。
# PLATFORM_DATASET_LEASE_TTL_S=180
# 单表每轮最多处理的桶数量。
# PLATFORM_DATASET_MAX_BUCKETS_PER_TICK=240
# 每次额外重算的最近已关闭桶数量。
# PLATFORM_DATASET_RECOMPUTE_TAIL_BUCKETS=2
# 是否按台账保留期删除过期数据。
# PLATFORM_DATASET_RETENTION_ENABLED=false
# 台账过期清理间隔秒数。
# PLATFORM_DATASET_RETENTION_INTERVAL_S=86400.0
# 台账过期清理单活租约有效期秒数。
# PLATFORM_DATASET_RETENTION_LEASE_TTL_S=90000
# 每轮台账清理最多删除的行数。
# PLATFORM_DATASET_RETENTION_MAX_ROWS_PER_RUN=200000
# 单表过期清理超时秒数。
# PLATFORM_DATASET_RETENTION_TABLE_TIMEOUT_S=300.0
# 台账单表每轮聚合的超时秒数。
# PLATFORM_DATASET_TABLE_TIMEOUT_S=60.0

# PLC 与 HTTP 采集访问

# HTTP 数据与 OAuth2 端点的精确 origin，逗号分隔。
# COLLECT_HTTP_ALLOWED_ENDPOINTS=
# 全进程 HTTP 采集并发请求上限。
# COLLECT_HTTP_MAX_CONCURRENT_REQUESTS=8
# 是否启用只读 HTTP 协议采集，默认关闭。
# COLLECT_HTTP_READ_ENABLED=false
# PLC 只读允许清单，按 IP:端口 用逗号分隔。
# COLLECT_PLC_ALLOWED_ENDPOINTS=
# 所有 PLC 合计在途读取请求上限。
# COLLECT_PLC_MAX_CONCURRENT_REQUESTS=8
# 是否启用经过现场授权的 PLC 只读采集。
# COLLECT_PLC_READ_ENABLED=false

# 迁移作业与业务账号分离

# 每条迁移或种子命令的超时秒数。
# MIGRATION_COMMAND_TIMEOUT_S=600
# 统一迁移等待 PostgreSQL 可连接的超时秒数。
# MIGRATION_DATABASE_WAIT_TIMEOUT_S=120
# 迁移专用 PostgreSQL 密码，未设置时使用 POSTGRES_PASSWORD。
# MIGRATION_POSTGRES_PASSWORD=
# 迁移专用 PostgreSQL 账号，未设置时沿用应用账号，独立账号须先配置业务访问权限。
# MIGRATION_POSTGRES_USER=

# 认证与登录参数

# API 密钥最近使用时间的写库间隔秒数。
# AUTH_API_KEY_TOUCH_INTERVAL_S=60
# API 密钥散列验证缓存有效期秒数。
# AUTH_API_KEY_VERIFY_CACHE_TTL_S=60
# 关停时等待在途工作完成的秒数。
# AUTH_APP_DRAIN_TIMEOUT_S=20.0
# 日志输出格式。
# AUTH_APP_LOG_FORMAT=json
# 日志输出级别。
# AUTH_APP_LOG_LEVEL=INFO
# 正常请求链路的采样比例。
# AUTH_APP_TRACE_SAMPLE_RATIO=0.1
# argon2 口令通道并发上限，每路约占 64MiB。
# AUTH_ARGON2_PASSWORD_MAX_CONCURRENCY=2
# argon2 API 密钥通道并发上限，每路约占 64MiB。
# AUTH_ARGON2_API_KEY_MAX_CONCURRENCY=2
# 边缘权限缓存有效期秒数。
# AUTH_EDGE_PERMISSION_TTL_S=60
# 登录 access token 有效期秒数，保持 900。
# AUTH_JWT_ACCESS_TTL_S=900
# JWT 签发者名称。
# AUTH_JWT_ISSUER=auth-server
# JWT 轮换期间保留的旧签名密钥，null 恢复默认或继承。
# AUTH_JWT_PREVIOUS_SECRET=
# 登录 refresh token 有效期秒数。
# AUTH_JWT_REFRESH_TTL_S=1209600
# 登录限流窗口内的尝试次数上限。
# AUTH_LOGIN_MAX_ATTEMPTS=10
# 登录限流窗口秒数。
# AUTH_LOGIN_WINDOW_S=300
# PostgreSQL 连接超时秒数。
# AUTH_POSTGRES_CONNECT_TIMEOUT_S=5.0
# PostgreSQL 等待锁的超时毫秒数。
# AUTH_POSTGRES_LOCK_TIMEOUT_MS=3000
# PostgreSQL 额外连接数上限。
# AUTH_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# AUTH_POSTGRES_POOL_SIZE=10
# PostgreSQL 语句超时毫秒数。
# AUTH_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# Redis 数据库编号。
# AUTH_REDIS_DB=0
# Redis 请求超时秒数。
# AUTH_REDIS_TIMEOUT_S=1.0
# 注册账号的初始角色名称。
# AUTH_SIGNUP_DEFAULT_ROLE=viewer
# 是否开放账号注册。
# AUTH_SIGNUP_ENABLED=false
# 注册限流窗口内的尝试次数上限。
# AUTH_SIGNUP_MAX_ATTEMPTS=5
# 注册限流窗口秒数。
# AUTH_SIGNUP_WINDOW_S=3600

# 平台业务与运行参数

# 开机事件每日增量任务拉取阻塞毫秒数。
# PLATFORM_ACDAILY_BLOCK_MS=5000
# 开机事件每日增量任务重新认领门槛毫秒数。
# PLATFORM_ACDAILY_CLAIM_IDLE_MS=300000
# 开机事件每日增量任务的消费组名称。
# PLATFORM_ACDAILY_GROUP=ac-startup-daily-workers
# 开机事件每日增量调度租约有效期秒数。
# PLATFORM_ACDAILY_LEASE_TTL_S=180
# 每次拉取的开机事件每日增量任务数量。
# PLATFORM_ACDAILY_PREFETCH=1
# 开机事件每日增量调度检查间隔秒数。
# PLATFORM_ACDAILY_SCHEDULER_INTERVAL_S=60.0
# 开机事件每日增量任务的 Redis Stream 名称。
# PLATFORM_ACDAILY_STREAM=platform:ac-startup:daily
# 单次开机事件每日增量任务超时秒数。
# PLATFORM_ACDAILY_TIMEOUT_S=300.0
# 空调模型训练任务拉取阻塞毫秒数。
# PLATFORM_ACMODEL_BLOCK_MS=5000
# 空调模型训练任务重新认领门槛毫秒数。
# PLATFORM_ACMODEL_CLAIM_IDLE_MS=300000
# 空调模型训练任务的消费组名称。
# PLATFORM_ACMODEL_GROUP=ac-model-trainers
# 每次拉取的空调模型训练任务数量。
# PLATFORM_ACMODEL_PREFETCH=1
# 空调模型训练任务的 Redis Stream 名称。
# PLATFORM_ACMODEL_STREAM=platform:ac-model:train
# 单次空调模型训练超时秒数。
# PLATFORM_ACMODEL_TRAIN_TIMEOUT_S=900.0
# 空调预测每轮总预算秒数。
# PLATFORM_ACPUBLISH_BUDGET_S=45.0
# 空调预测下发循环间隔秒数。
# PLATFORM_ACPUBLISH_INTERVAL_S=60.0
# 空调预测下发单活租约有效期秒数。
# PLATFORM_ACPUBLISH_LEASE_TTL_S=180
# 单个空调模型预测与下发超时秒数。
# PLATFORM_ACPUBLISH_MODEL_TIMEOUT_S=20.0
# EMS 无时区时间列使用的业务时区。
# PLATFORM_ACSOURCE_TIMEZONE=Asia/Shanghai
# 开机事件分片任务拉取阻塞毫秒数。
# PLATFORM_ACSTARTUP_BLOCK_MS=5000
# 开机事件分片任务重新认领门槛毫秒数。
# PLATFORM_ACSTARTUP_CLAIM_IDLE_MS=60000
# 开机事件分片任务的消费组名称。
# PLATFORM_ACSTARTUP_GROUP=ac-startup-workers
# 单台空调每个分片最多读取的行数。
# PLATFORM_ACSTARTUP_MAX_ROWS=60000
# 每次拉取的开机事件分片任务数量。
# PLATFORM_ACSTARTUP_PREFETCH=8
# 开机事件单个分片任务超时秒数。
# PLATFORM_ACSTARTUP_SHARD_TIMEOUT_S=300.0
# 开机事件分片任务的 Redis Stream 名称。
# PLATFORM_ACSTARTUP_STREAM=platform:ac-startup:shards
# 关停时等待在途工作完成的秒数。
# PLATFORM_APP_DRAIN_TIMEOUT_S=20.0
# 日志输出格式。
# PLATFORM_APP_LOG_FORMAT=json
# 日志输出级别。
# PLATFORM_APP_LOG_LEVEL=INFO
# 正常请求链路的采样比例。
# PLATFORM_APP_TRACE_SAMPLE_RATIO=0.1
# 模型素材压缩任务的消费组名称。
# PLATFORM_ASSETCOMPRESS_GROUP=asset-compress-workers
# 模型素材压缩使用的 Node 命令。
# PLATFORM_ASSETCOMPRESS_NODE=node
# 模型素材压缩脚本在容器中的路径。
# PLATFORM_ASSETCOMPRESS_SCRIPT=/app/nodetools/compress-model.mjs
# 模型素材压缩任务的 Redis Stream 名称。
# PLATFORM_ASSETCOMPRESS_STREAM=platform:asset:compress
# 浏览现场地址空间的超时秒数。
# PLATFORM_COLLECT_BROWSE_TIMEOUT_S=10.0
# 点位历史聚合使用的业务时区。
# PLATFORM_COLLECT_BUCKET_TIMEZONE=Asia/Shanghai
# 采集命令应答的超时秒数。
# PLATFORM_COLLECT_COMMAND_TIMEOUT_S=5.0
# 采集数据源凭据的加密密钥，必填且至少 32 字符。
# PLATFORM_COLLECT_CREDENTIAL_SECRET=
# 点位历史只读连接池大小。
# PLATFORM_COLLECT_HISTORY_POOL_SIZE=5
# 点位历史查询超时毫秒数。
# PLATFORM_COLLECT_HISTORY_STATEMENT_TIMEOUT_MS=15000
# 采集配置页每个数据源实时点位上限。
# PLATFORM_COLLECT_LIVE_MAX_POINTS=1000
# 采集配置页实时点位清单刷新间隔秒数。
# PLATFORM_COLLECT_LIVE_PLAN_TTL_S=10.0
# 采集计划变更的 Redis 广播频道。
# PLATFORM_COLLECT_PLAN_CHANNEL=collect:plan:changed
# 浏览完整地址子树的超时秒数。
# PLATFORM_COLLECT_SUBTREE_TIMEOUT_S=15.0
# 分析建模任务拉取阻塞毫秒数。
# PLATFORM_MODELING_BLOCK_MS=5000
# 分析建模任务重新认领门槛毫秒数。
# PLATFORM_MODELING_CLAIM_IDLE_MS=1800000
# 分析建模任务的消费组名称。
# PLATFORM_MODELING_GROUP=modeling-runners
# 每次拉取的分析建模任务数量。
# PLATFORM_MODELING_PREFETCH=1
# 每条流水线保留的运行明细数量。
# PLATFORM_MODELING_RUN_KEEP_PER_PIPELINE=20
# 分析建模运行记录保留天数。
# PLATFORM_MODELING_RUN_RETENTION_DAYS=90
# 分析建模任务心跳陈旧判定分钟数。
# PLATFORM_MODELING_STALE_MINUTES=60
# 分析建模任务的 Redis Stream 名称。
# PLATFORM_MODELING_STREAM=platform:modeling:run
# 可声明外部操作人的专用网关账号 UUID，JSON 数组；默认不信任任何账号。
# PLATFORM_MODELING_TRUSTED_OPERATOR_ACCOUNTS=[]
# 对象存储连接超时秒数。
# PLATFORM_OBJECTSTORE_CONNECT_TIMEOUT_S=3.0
# 对象存储单次操作的尝试次数上限。
# PLATFORM_OBJECTSTORE_MAX_ATTEMPTS=2
# 是否按路径方式访问 S3 存储桶。
# PLATFORM_OBJECTSTORE_PATH_STYLE_ENABLED=true
# 对象存储读取超时秒数。
# PLATFORM_OBJECTSTORE_READ_TIMEOUT_S=10.0
# S3 签名使用的区域名称。
# PLATFORM_OBJECTSTORE_REGION=us-east-1
# OPC UA 服务端的内部 HTTP 地址。
# PLATFORM_OPCUA_BASE_URL=http://opcua-server:8008
# OPC UA 服务端请求超时秒数。
# PLATFORM_OPCUA_TIMEOUT_S=5.0
# PostgreSQL 连接超时秒数。
# PLATFORM_POSTGRES_CONNECT_TIMEOUT_S=5.0
# PostgreSQL 等待锁的超时毫秒数。
# PLATFORM_POSTGRES_LOCK_TIMEOUT_MS=3000
# PostgreSQL 额外连接数上限。
# PLATFORM_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# PLATFORM_POSTGRES_POOL_SIZE=10
# PostgreSQL 语句超时毫秒数。
# PLATFORM_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# 实时发布单活租约有效期秒数。
# PLATFORM_PUBLISH_LEASE_TTL_S=15
# 单次实时推送条目上限，不能超过 hub 上限。
# PLATFORM_PUBLISH_MAX_ITEMS=200
# 实时主题登记对账间隔秒数。
# PLATFORM_PUBLISH_RECONCILE_INTERVAL_S=5.0
# 实时订阅关系只读连接池大小。
# PLATFORM_PUBLISH_VIEWER_POOL_SIZE=2
# 实时推送合并窗口毫秒数。
# PLATFORM_PUBLISH_WINDOW_MS=2000
# 实时通道的内部 HTTP 地址。
# PLATFORM_REALTIME_BASE_URL=http://realtime-hub:8000
# 实时通道请求超时秒数。
# PLATFORM_REALTIME_TIMEOUT_S=2.0
# Redis 数据库编号。
# PLATFORM_REDIS_DB=0
# Redis 请求超时秒数。
# PLATFORM_REDIS_TIMEOUT_S=1.0
# 只读 EMS SQL Server 客户端字符集。
# PLATFORM_SQLSERVER_CHARSET=UTF-8
# 只读 EMS SQL Server 数据库名。
# PLATFORM_SQLSERVER_DATABASE=
# 只读 EMS SQL Server 主机地址。
# PLATFORM_SQLSERVER_HOST=
# 只读 EMS SQL Server 登录超时秒数。
# PLATFORM_SQLSERVER_LOGIN_TIMEOUT_S=5.0
# 只读 EMS SQL Server 登录密码。
# PLATFORM_SQLSERVER_PASSWORD=
# 只读 EMS SQL Server 连接回收间隔秒数。
# PLATFORM_SQLSERVER_POOL_RECYCLE_S=3600
# 只读 EMS SQL Server 连接池大小。
# PLATFORM_SQLSERVER_POOL_SIZE=5
# 只读 EMS SQL Server 端口。
# PLATFORM_SQLSERVER_PORT=1433
# 只读 EMS SQL Server 查询超时秒数。
# PLATFORM_SQLSERVER_QUERY_TIMEOUT_S=15.0
# 只读 EMS SQL Server 登录账号。
# PLATFORM_SQLSERVER_USER=

# 采集运行与历史归档

# 关停时等待在途工作完成的秒数。
# COLLECT_APP_DRAIN_TIMEOUT_S=20.0
# 日志输出格式。
# COLLECT_APP_LOG_FORMAT=json
# 日志输出级别。
# COLLECT_APP_LOG_LEVEL=INFO
# 正常请求链路的采样比例。
# COLLECT_APP_TRACE_SAMPLE_RATIO=0.1
# 单批点位历史归档行数上限。
# COLLECT_ARCHIVE_BATCH_ROWS=1000
# 点位历史归档缓冲行数上限。
# COLLECT_ARCHIVE_BUFFER_MAX=200000
# 是否启用点位历史归档。
# COLLECT_ARCHIVE_ENABLED=true
# 点位历史归档缓冲刷新间隔毫秒数。
# COLLECT_ARCHIVE_FLUSH_MS=5000
# 点位历史归档 Stream 条目上限。
# COLLECT_ARCHIVE_STREAM_MAXLEN=10000
# 点位历史聚合时区，PLATFORM_COLLECT_BUCKET_TIMEZONE 优先。
# COLLECT_BUCKET_TIMEZONE=Asia/Shanghai
# 采集命令拉取阻塞秒数。
# COLLECT_COMMAND_BLOCK_S=1.0
# 采集命令应答键有效期秒数。
# COLLECT_COMMAND_REPLY_TTL_S=60
# 点位实时快照写入窗口毫秒数。
# COLLECT_FLUSH_INTERVAL_MS=300
# 现场连接心跳检查间隔秒数。
# COLLECT_HEARTBEAT_INTERVAL_S=10.0
# 采集计划变更广播频道，PLATFORM_COLLECT_PLAN_CHANNEL 优先。
# COLLECT_PLAN_CHANNEL=collect:plan:changed
# 采集计划全量刷新间隔秒数。
# COLLECT_PLAN_REFRESH_INTERVAL_S=30.0
# 采集计划拉取超时秒数。
# COLLECT_PLAN_TIMEOUT_S=5.0
# 业务平台的内部 HTTP 地址。
# COLLECT_PLATFORM_BASE_URL=http://platform-server:8005
# PostgreSQL 连接超时秒数。
# COLLECT_POSTGRES_CONNECT_TIMEOUT_S=5.0
# PostgreSQL 等待锁的超时毫秒数。
# COLLECT_POSTGRES_LOCK_TIMEOUT_MS=3000
# PostgreSQL 额外连接数上限。
# COLLECT_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# COLLECT_POSTGRES_POOL_SIZE=10
# PostgreSQL 语句超时毫秒数。
# COLLECT_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# 现场连接重连退避上限秒数。
# COLLECT_RECONNECT_MAX_BACKOFF_S=60.0
# Redis 数据库编号。
# COLLECT_REDIS_DB=0
# Redis 请求超时秒数。
# COLLECT_REDIS_TIMEOUT_S=1.0
# 点位实时快照有效期秒数。
# COLLECT_SNAPSHOT_TTL_S=60

# OPC UA 服务端与证书

# 关停时等待在途工作完成的秒数。
# OPCUA_APP_DRAIN_TIMEOUT_S=20.0
# 日志输出格式。
# OPCUA_APP_LOG_FORMAT=json
# 日志输出级别。
# OPCUA_APP_LOG_LEVEL=INFO
# 正常请求链路的采样比例。
# OPCUA_APP_TRACE_SAMPLE_RATIO=0.1
# OPC UA 自签证书有效天数。
# OPCUA_CERT_VALID_DAYS=825
# 同时运行的 OPC UA 实例数量上限。
# OPCUA_MAX_INSTANCES=16
# PostgreSQL 连接超时秒数。
# OPCUA_POSTGRES_CONNECT_TIMEOUT_S=5.0
# PostgreSQL 等待锁的超时毫秒数。
# OPCUA_POSTGRES_LOCK_TIMEOUT_MS=3000
# PostgreSQL 额外连接数上限。
# OPCUA_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# OPCUA_POSTGRES_POOL_SIZE=10
# PostgreSQL 语句超时毫秒数。
# OPCUA_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# 单次 OPC UA 实时推送的节点数量上限。
# OPCUA_PUBLISH_MAX_NODES=500
# 实时推送合并窗口毫秒数。
# OPCUA_PUBLISH_WINDOW_MS=1000
# 实时通道的内部 HTTP 地址。
# OPCUA_REALTIME_BASE_URL=http://realtime-hub:8000
# 实时通道请求超时秒数。
# OPCUA_REALTIME_TIMEOUT_S=2.0
# Redis 数据库编号。
# OPCUA_REDIS_DB=0
# Redis 请求超时秒数。
# OPCUA_REDIS_TIMEOUT_S=1.0

# 实时通道与订阅

# 关停时等待在途工作完成的秒数。
# REALTIME_APP_DRAIN_TIMEOUT_S=20.0
# 日志输出格式。
# REALTIME_APP_LOG_FORMAT=json
# 日志输出级别。
# REALTIME_APP_LOG_LEVEL=INFO
# 正常请求链路的采样比例。
# REALTIME_APP_TRACE_SAMPLE_RATIO=0.1
# 认证服务的内部 HTTP 地址。
# REALTIME_AUTH_BASE_URL=http://auth-server:8004
# 认证服务请求超时秒数。
# REALTIME_AUTH_TIMEOUT_S=2.0
# 实时消息跨副本扇出的 Redis 频道。
# REALTIME_FANOUT_CHANNEL=realtime.fanout
# 实时通道单次推送条目数量上限。
# REALTIME_MAX_PAYLOAD_ITEMS=500
# WebSocket 权限复核间隔秒数。
# REALTIME_PERMISSION_TTL_S=60
# PostgreSQL 连接超时秒数。
# REALTIME_POSTGRES_CONNECT_TIMEOUT_S=5.0
# PostgreSQL 等待锁的超时毫秒数。
# REALTIME_POSTGRES_LOCK_TIMEOUT_MS=3000
# PostgreSQL 额外连接数上限。
# REALTIME_POSTGRES_POOL_OVERFLOW=5
# PostgreSQL 常驻连接池大小。
# REALTIME_POSTGRES_POOL_SIZE=10
# PostgreSQL 语句超时毫秒数。
# REALTIME_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# 匿名 WebSocket 单次授权有效期秒数。
# REALTIME_PUBLIC_GRANT_TTL_S=3600
# 单副本匿名 WebSocket 连接总数上限。
# REALTIME_PUBLIC_MAX_CONNECTIONS=500
# 同一公开票据的匿名 WebSocket 连接上限。
# REALTIME_PUBLIC_MAX_CONNECTIONS_PER_TICKET=50
# 匿名 WebSocket 授权复核间隔秒数。
# REALTIME_PUBLIC_RECHECK_INTERVAL_S=15.0
# Redis 数据库编号。
# REALTIME_REDIS_DB=0
# Redis 请求超时秒数。
# REALTIME_REDIS_TIMEOUT_S=1.0

# 可选层级图（--profile hierarchy）

# 层级图 app drain timeout s。
# HIERARCHY_APP_DRAIN_TIMEOUT_S=20.0
# 层级图 app instance。
# HIERARCHY_APP_INSTANCE=
# 层级图 app log format。
# HIERARCHY_APP_LOG_FORMAT=json
# 层级图 app log level。
# HIERARCHY_APP_LOG_LEVEL=INFO
# 层级图 app trace sample ratio。
# HIERARCHY_APP_TRACE_SAMPLE_RATIO=0.1
# 层级图 postgres connect timeout s。
# HIERARCHY_POSTGRES_CONNECT_TIMEOUT_S=5.0
# 层级图 postgres lock timeout ms。
# HIERARCHY_POSTGRES_LOCK_TIMEOUT_MS=3000
# 层级图 postgres pool overflow。
# HIERARCHY_POSTGRES_POOL_OVERFLOW=5
# 层级图 postgres pool size。
# HIERARCHY_POSTGRES_POOL_SIZE=10
# 层级图 postgres statement timeout ms。
# HIERARCHY_POSTGRES_STATEMENT_TIMEOUT_MS=2000
# 层级图 redis db。
# HIERARCHY_REDIS_DB=0
# 层级图 redis timeout s。
# HIERARCHY_REDIS_TIMEOUT_S=1.0

# 共享兼容别名、对象存储与 EMS 连接参数

# EMS 客户端字符集，中文旧库通常使用 CP936。
# ACSOURCE_CHARSET=UTF-8
# 开机事件分片消费组名称，PLATFORM_ACSTARTUP_GROUP 优先。
# ACSTARTUP_GROUP=ac-startup-workers
# 开机事件分片任务流名称，PLATFORM_ACSTARTUP_STREAM 优先。
# ACSTARTUP_STREAM=platform:ac-startup:shards
# 大屏单次实时推送条目上限，PLATFORM_PUBLISH_MAX_ITEMS 优先。
# DASHBOARD_PUBLISH_MAX_ITEMS=200
# 大屏实时推送窗口毫秒数，PLATFORM_PUBLISH_WINDOW_MS 优先。
# DASHBOARD_PUBLISH_WINDOW_MS=2000
